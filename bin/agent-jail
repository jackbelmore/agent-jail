#!/usr/bin/env bash
# agent-jail -- run an AI coding agent confined to the current directory.
#
# Filesystem: bubblewrap. The agent can write the current directory and its own
# private state, read /usr and a handful of /etc files, and see nothing else of
# $HOME. Network: pasta in a separate network namespace plus an nftables egress
# filter, so the agent reaches the public internet but not the host's localhost
# services, abstract sockets (X11), the LAN or a tailnet.
#
# What this does and does not protect: docs/THREAT_MODEL.md

# Profiles and helpers are called indirectly via "profile_$name".
# shellcheck disable=SC2317,SC2329
set -euo pipefail

readonly VERSION=0.2.0
readonly DNS_ADDR=169.254.1.1     # address pasta answers DNS on, inside the jail
# File names hidden in the project unless --no-hide, and the ones among them
# that stay visible: templates, not secrets. --hide and --show add to these.
readonly HIDE_DEFAULT=(.env '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' '*.jks' '*.keystore'
    id_rsa id_dsa id_ecdsa id_ecdsa_sk id_ed25519 id_ed25519_sk
    .netrc .git-credentials .pgpass '*.kdbx')
readonly SHOW_DEFAULT=('*.example' '*.sample' '*.template' '*.dist')
prog=${0##*/}

# Agents agent-jail knows how to find and install, in the order the picker
# lists them: profile|name shown|npm package|command.
readonly AGENTS=(
    "claude|Claude Code|@anthropic-ai/claude-code|claude"
    "codex|Codex|@openai/codex|codex"
    "gemini|Gemini CLI|@google/gemini-cli|gemini"
    "qwen|Qwen Code|@qwen-code/qwen-code|qwen"
    "opencode|OpenCode|opencode-ai|opencode"
    "continue|Continue|@continuedev/cli|cn"
)

die()  { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
warn() { printf '%s: warning: %s\n' "$prog" "$*" >&2; }
say()  { printf '%s: %s\n' "$prog" "$*" >&2; }

usage() {
    local names=() line hide
    for line in "${AGENTS[@]}"; do names+=("${line%%|*}"); done
    hide=$(fmt -w 78 <<<"Hidden in the project unless --no-hide: files named ${HIDE_DEFAULT[*]},
except ${SHOW_DEFAULT[*]}. A hidden file is still listed but can't be opened;
if git has it, git show can still print what was committed.")
    cat <<EOF
Usage: $prog [options] [PROFILE [ARGS...]]

Run PROFILE's agent so it can write only the current directory and its own
private state, read nothing else in \$HOME, and reach the public internet but
not localhost, the LAN or other sockets on this machine. Without PROFILE, pick
one from a list.

Profiles: ${names[*]} shell

Options:
  --net MODE        isolated  public internet only, via pasta (default)
                    none      no network at all
                    host      share the host network (UNSAFE: localhost
                              services and X11 become reachable)
  --host-port PORT  with --net isolated, forward 127.0.0.1:PORT inside the
                    jail to 127.0.0.1:PORT on the host, e.g. 11434 for a local
                    Ollama (repeatable)
  --git MODE        protect   .git/hooks and .git/config read-only (default)
                    ro        all of .git read-only (no commits inside)
                    off       no extra git protection
  --ro PATH         also expose PATH read-only (repeatable)
  --hide PATTERN    also hide project files whose name matches PATTERN, a
                    glob such as '*.secret' (repeatable)
  --show PATTERN    don't hide files whose name matches PATTERN (repeatable)
  --no-hide         hide nothing, not even the default list below
  --shell           start bash inside PROFILE's sandbox instead of the agent,
                    to see exactly what the agent would see
  --list            list the agents and whether they are installed
  --check           check that everything agent-jail needs is installed
  --install NAME    install or update NAME's npm package for the jail; npm
                    and the package's install scripts run inside a jail too
  --force           run in a directory that is normally refused
  --dry-run         print the sandbox command instead of running it
  -h, --help        show this help
  --version         print the version

$hide

Agent state lives in \${AGENT_JAIL_HOME:-\${XDG_DATA_HOME:-~/.local/share}/agent-jail}/PROFILE,
never in the agent's normal config directories. Agents installed with
--install live in its tools/ directory and are used before any on your PATH.
EOF
}

# --- helpers ----------------------------------------------------------------

# Resolve a command on the host PATH to its real file.
resolve() {
    local p
    p=$(command -v -- "$1" 2>/dev/null) || return 1
    readlink -f -- "$p"
}

# Find a system tool even when sbin directories are not on PATH (Debian/Ubuntu).
find_tool() {
    local d
    command -v -- "$1" 2>/dev/null && return 0
    for d in /usr/sbin /sbin /usr/bin; do
        [[ -x $d/$1 ]] && { echo "$d/$1"; return 0; }
    done
    return 1
}

# Walk up from a file inside an npm package to the package root, so the whole
# package (and its bundled native binaries) is exposed, read-only.
pkg_root() {
    local d=${1%/*} parent
    while [[ $d == /*/* ]]; do
        parent=${d%/*}
        if [[ ${parent##*/} == node_modules ]] ||
           [[ ${parent##*/} == @* && ${parent%/*} == */node_modules ]]; then
            printf '%s\n' "$d"
            return 0
        fi
        d=$parent
    done
    return 1
}

# Print why a working directory is refused, or nothing if it is fine.
refuse_reason() {
    local w=$1 d
    [[ $HOME/ == "$w"/* ]] && { echo "it contains your home directory"; return; }
    [[ $w == /*/* ]] || { echo "it is a top-level directory"; return; }
    mountpoint -q -- "$w" 2>/dev/null && { echo "it is the root of a mounted filesystem"; return; }
    for d in .ssh .gnupg .config .local .cache .pki .password-store .mozilla \
             .aws .kube .docker .var .claude .codex .gemini; do
        if [[ $w == "$HOME/$d" || $w == "$HOME/$d"/* ]]; then
            echo "it is inside ~/$d"
            return
        fi
    done
}

# Every .git entry (directory, or pointer file in a worktree/submodule) under
# the working directory, and every commondir file inside one, skipping
# dependency trees, as "device:inode path": a .git replaced by a new one at the
# same path is a different entry. A commondir file makes git take its config
# and hooks from the directory it names, so it counts as a pointer file. -mindepth 1
# keeps a working directory that is itself called venv or target from being
# pruned.
find_git() {
    find "$1" -mindepth 1 -maxdepth 6 \
        \( -name node_modules -o -name .venv -o -name venv -o -name target \) -prune \
        -o \( -name .git -o -name commondir -path '*/.git/*' \) -printf '%D:%i %p\n' \
        2>/dev/null | LC_ALL=C sort
}

# Checksums of the project files that agents, editors and direnv load code from
# (hooks, MCP servers, plugins, tasks) when you open the project on the host.
find_autorun() {
    local d=$1
    {
        find "$d" -maxdepth 1 -type f \( -name .mcp.json -o -name .envrc \
            -o -name opencode.json -o -name opencode.jsonc \) -print0 || true
        find "$d"/.claude "$d"/.codex "$d"/.gemini "$d"/.qwen "$d"/.opencode \
            "$d"/.continue "$d"/.vscode -maxdepth 4 -type f -print0 || true
    } 2>/dev/null | xargs -0r sha256sum | LC_ALL=C sort
}

# Set hidden to the files under the working directory $1 that match a default
# hide pattern but no default exception, or a --hide pattern; and no --show
# pattern. .git and dependency trees are skipped. A matching
# symlink hides the file it leads to, if that is in the working directory;
# anything else it leads to isn't in the jail anyway.
find_secrets() {
    local d=$1 p f names=() keep=()
    local -A seen=()
    hidden=()
    if ((hide_default)); then
        for p in "${HIDE_DEFAULT[@]}"; do names+=(-o -name "$p"); done
        names=(\( "${names[@]:1}" \))
        for p in "${SHOW_DEFAULT[@]}"; do names+=(! -name "$p"); done
        names=(-o \( "${names[@]}" \))
    fi
    for p in "${hide_patterns[@]}"; do names+=(-o -name "$p"); done
    for p in "${show_patterns[@]}"; do keep+=(! -name "$p"); done
    ((${#names[@]})) || return 0
    while IFS= read -r -d '' f; do
        if [[ -L $f ]]; then
            f=$(readlink -f -- "$f") || continue
            [[ $f == "$d"/* && -f $f ]] || continue
        fi
        [[ -n ${seen[$f]:-} ]] && continue
        seen[$f]=1
        hidden+=("$f")
    done < <(find "$d" -mindepth 1 \
                 \( -name .git -o -name node_modules -o -name .venv -o -name venv \
                    -o -name target \) -prune \
                 -o \( -type f -o -type l \) \( "${names[@]:1}" \) "${keep[@]}" -print0 \
                 2>/dev/null)
}

# Shorten $HOME to ~ for display.
tilde() { printf '%s\n' "${1/#"$HOME"/\~}"; }

# --- agents -----------------------------------------------------------------

# Look up agent NAME in AGENTS; sets a_title, a_pkg and a_cmd.
agent_info() {
    local line name
    for line in "${AGENTS[@]}"; do
        IFS='|' read -r name a_title a_pkg a_cmd <<<"$line"
        [[ $name == "$1" ]] && return 0
    done
    return 1
}

# The real file of agent NAME's command: agent-jail's own install, then PATH.
find_agent() {
    agent_info "$1" || return 1
    local own=$tools_dir/$1/bin/$a_cmd real
    if [[ -e $own || -L $own ]]; then
        # The install was written from inside a jail; its command must not lead
        # anywhere else, or that place would be exposed to the agent.
        real=$(readlink -f -- "$own")
        if [[ $real != "$(readlink -f -- "$tools_dir/$1")"/* ]]; then
            warn "ignoring $(tilde "$own"): it points outside its install"
            return 1
        fi
        echo "$real"
    else
        resolve "$a_cmd"
    fi
}

# Expose the host's node read-only and set $node to it.
use_node() {
    node=$(resolve node) || die "node is not installed (needed for $1)"
    ro_paths+=("$node")
    # Agents start node themselves (MCP servers, hooks), so keep it on PATH.
    [[ ${node%/*} == /usr/bin ]] || path+=("${node%/*}")
}

# Set cmd and ro_paths to run agent NAME: its whole npm package read-only, plus
# node when the entry point is a node script rather than a native binary.
use_agent() {
    local bin first
    agent_info "$1"
    bin=$(find_agent "$1") || die "$a_title is not installed; install it with: $prog --install $1"
    ro_paths+=("$(pkg_root "$bin" || echo "$bin")")
    first=$(head -c128 -- "$bin" | tr -d '\0' | head -n1)
    if [[ $first == '#!'*node* || ( $first != '#!'* && $first != $'\x7fELF'* ) ]]; then
        use_node "$a_title"
        cmd=("$node" "$bin")
    else
        cmd=("$bin")
    fi
}

# Create a settings file in the profile's state the first time only; never
# write through a planted symlink.
seed() {
    local f=$state_dir/$1
    [[ -e $f || -L $f ]] && return 0
    mkdir -p -- "${f%/*}"
    (set -C; printf '%s\n' "$2" >"$f")
}

# --- profiles ---------------------------------------------------------------
# A profile sets:
#   cmd          the command to run (absolute paths)
#   ro_paths     host paths exposed read-only at the same path (program files)
#   state        paths relative to $HOME the agent may write; backed by
#                agent-jail's own state directory, never the real ones
#   imports      paths relative to $HOME bound read-only from the real $HOME on
#                top of state, so you keep one config but the agent can't edit it
#   env          extra NAME=VALUE pairs
#   path         extra directories put in front of PATH
#   block_hosts  hostnames that resolve to 0.0.0.0 inside the jail

profile_claude() {
    use_agent claude
    state=(.claude)
    # With CLAUDE_CONFIG_DIR set, .claude.json lives in ~/.claude too, so all
    # of Claude Code's state is in one private directory.
    env=(CLAUDE_CONFIG_DIR="$HOME/.claude" DISABLE_AUTOUPDATER=1)
}

profile_codex() {
    use_agent codex
    state=(.codex)
    # Codex sandboxes the commands it runs with its own bubblewrap, which needs
    # the user namespaces this jail disables, so every command would fail. The
    # jail is the sandbox: start with Codex's own turned off. Approval prompts
    # are a separate setting and stay as they are.
    seed .codex/config.toml 'sandbox_mode = "danger-full-access"
check_for_update_on_startup = false'
}

profile_gemini() {
    use_agent gemini
    state=(.gemini)
    # The package is read-only in the jail: update with --install instead.
    seed .gemini/settings.json '{
  "general": { "enableAutoUpdate": false, "enableAutoUpdateNotification": false },
  "privacy": { "usageStatisticsEnabled": false }
}'
}

profile_qwen() {
    use_agent qwen
    state=(.qwen)
    # Qwen Code's usage-statistics (RUM) endpoint.
    block_hosts=(gb4w8c3ygj-default-sea.rum.aliyuncs.com)
    seed .qwen/settings.json '{
  "general": { "enableAutoUpdate": false },
  "privacy": { "usageStatisticsEnabled": false }
}'
}

profile_opencode() {
    use_agent opencode
    state=(.config/opencode .local/share/opencode .cache/opencode .local/state/opencode)
    imports=(.config/opencode/opencode.json .config/opencode/opencode.jsonc)
    env=(OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_SHARE=1)
}

profile_continue() {
    use_agent continue
    state=(.continue)
    imports=(.continue/config.yaml)
}

profile_shell() {
    cmd=(/usr/bin/bash)
}

# --- the sandbox ------------------------------------------------------------

# Set run to the command that starts cmd in a jail on directory $1, with git
# protection $2, from the profile variables above.
build_jail() {
    local dir=$1 git=$2 b p rel kv g f m h ports
    {
        printf '127.0.0.1 localhost agent-jail\n::1 localhost agent-jail\n'
        for h in "${block_hosts[@]}"; do printf '0.0.0.0 %s\n:: %s\n' "$h" "$h"; done
    } >"$tmp/hosts"

    b=(
        --ro-bind /usr /usr
        --symlink usr/lib /lib
        --symlink usr/lib64 /lib64
        --symlink usr/bin /bin
        --symlink usr/sbin /sbin
        --ro-bind "$tmp/hosts" /etc/hosts
    )
    for f in passwd group nsswitch.conf localtime ld.so.cache pki ssl ca-certificates \
             crypto-policies alternatives; do
        b+=(--ro-bind-try "/etc/$f" "/etc/$f")
    done
    case $net in
        isolated) printf 'nameserver %s\n' "$DNS_ADDR" >"$tmp/resolv.conf"
                  b+=(--ro-bind "$tmp/resolv.conf" /etc/resolv.conf) ;;
        host)     b+=(--ro-bind-try "$(readlink -f /etc/resolv.conf)" /etc/resolv.conf) ;;
    esac
    b+=(
        --proc /proc
        --dev /dev
        --tmpfs /dev/shm
        --tmpfs /tmp
        --tmpfs "$HOME"
    )
    for p in "${ro_paths[@]}"; do
        [[ -e $p ]] || die "no such path: $p"
        b+=(--ro-bind "$p" "$p")
    done
    for rel in "${state[@]}"; do
        mkdir -p -- "$state_dir/$rel"
        b+=(--bind "$state_dir/$rel" "$HOME/$rel")
    done
    for rel in "${imports[@]}"; do
        # The import lands on a mount point inside agent-writable state; a symlink
        # planted there by an earlier run must not redirect it.
        [[ -L $state_dir/$rel ]] && rm -f -- "$state_dir/$rel"
        b+=(--ro-bind-try "$HOME/$rel" "$HOME/$rel")
    done
    b+=(--bind "$dir" "$dir")

    # Git runs hooks and config-defined commands (core.fsmonitor, core.hooksPath,
    # filters, pagers) on the host the next time you type `git status` there. Make
    # the parts that can do that read-only for every repository in the directory.
    if [[ $git != off ]]; then
        # First pin each .git directory, and every directory between it and the
        # working directory, by binding it onto itself: a mount point can't be
        # renamed, so the agent can't move a repository aside and git init a
        # new one, with hooks of its choosing, in its place. Parents come first,
        # so that no pin covers a mount made inside it.
        local pins=() pin
        while IFS= read -r g; do
            g=${g#* }
            while [[ -n $g && $g != "$dir" ]]; do pins+=("$g"); g=${g%/*}; done
        done <<<"$git_before"
        if ((${#pins[@]})); then
            while IFS= read -r -d '' pin; do
                [[ -d $pin && ! -L $pin ]] && b+=(--bind "$pin" "$pin")
            done < <(printf '%s\0' "${pins[@]}" | LC_ALL=C sort -zu)
        fi
        while IFS= read -r g; do
            g=${g#* }
            [[ -n $g ]] || continue
            if [[ -L $g ]] || [[ -d $g && ( -L $g/hooks || -L $g/config ) ]]; then
                ((force)) || die "$g (or its hooks/config) is a symlink; inspect it or use --force"
            fi
            if [[ -f $g || $git == ro ]]; then
                # A pointer file (.git or commondir) must not be re-pointed at
                # an agent-made git dir.
                b+=(--ro-bind "$g" "$g")
                continue
            fi
            mkdir -p -- "$g/hooks"
            b+=(--ro-bind "$g/hooks" "$g/hooks")
            for f in config config.worktree; do
                [[ -e $g/$f ]] && b+=(--ro-bind "$g/$f" "$g/$f")
            done
            for m in "$g"/modules/*/ "$g"/worktrees/*/; do
                [[ -d $m ]] || continue
                for f in hooks config config.worktree; do
                    [[ -e $m$f ]] && b+=(--ro-bind "$m$f" "$m$f")
                done
            done
        done <<<"$git_before"
    fi

    # A secret file stays in place but becomes /dev/null on a nodev mount:
    # opening it fails, and it can't be removed, renamed or linked. This comes
    # after the pins above, which bind directories afresh from the host.
    for f in "${hidden[@]}"; do b+=(--ro-bind /dev/null "$f"); done

    b+=(
        --chdir "$dir"
        --unshare-all
        --unshare-user
        --disable-userns
        --uid "$(id -u)"
        --gid "$(id -g)"
        --hostname agent-jail
        --cap-drop ALL
        --die-with-parent
        --clearenv
        --setenv HOME "$HOME"
        --setenv USER "${USER:-$(id -un)}"
        --setenv LOGNAME "${USER:-$(id -un)}"
        --setenv PATH "$(IFS=:; echo "${path[*]}${path[*]:+:}/usr/bin:/bin")"
        --setenv TERM "${TERM:-xterm-256color}"
        --setenv COLORTERM "${COLORTERM:-truecolor}"
        --setenv LANG "${LANG:-C.UTF-8}"
        --setenv TMPDIR /tmp
        --setenv AGENT_JAIL "$profile"
    )
    for kv in "${env[@]}"; do b+=(--setenv "${kv%%=*}" "${kv#*=}"); done
    [[ $net != none ]] && b+=(--share-net)
    # TIOCSTI lets a process push keystrokes into its terminal, which the shell
    # would run after the jail exits. Kernels since 6.2 can turn it off; if it is
    # still on, detach the agent from the terminal instead.
    ((tiocsti)) && b+=(--new-session)

    run=(bwrap "${b[@]}" -- "${cmd[@]}")

    if [[ $net == isolated ]]; then
        pasta=$(find_tool pasta) || die "--net isolated needs pasta (passt package); or choose --net none"
        nft=$(find_tool nft) || die "--net isolated needs nft (nftables) for the egress filter"
        ports=$(IFS=,; echo "${host_ports[*]}")
        # Applied inside the jail's own network namespace, before bwrap starts. Only
        # public addresses are reachable; loopback works for forwarded host ports.
        cat >"$tmp/egress.nft" <<EOF
table inet agent_jail {
    chain output {
        type filter hook output priority 0; policy accept;
        oif "lo" accept
        ip daddr $DNS_ADDR meta l4proto { tcp, udp } th dport 53 accept
        meta l4proto ipv6-icmp accept
        ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
                   169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16,
                   198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } reject
        ip6 daddr { ::/128, ::1/128, ::ffff:0:0/96, 64:ff9b::/96, fc00::/7,
                    fe80::/10, ff00::/8 } reject
    }
}
EOF
        # shellcheck disable=SC2016  # $1/$@ are for the inner sh
        run=("$pasta" --config-net --quiet --no-map-gw --dns-forward "$DNS_ADDR"
             -t none -u none -T "${ports:-none}" -U none --
             /usr/bin/sh -c '"$1" -f "$2" && shift 2 && exec "$@"' agent-jail-net
             "$nft" "$tmp/egress.nft" "${run[@]}")
    fi
}

# Run $run, or print it with --dry-run. Ctrl-C belongs to the jailed process;
# this script just waits for it.
run_jail() {
    local status=0
    if ((dry_run)); then
        printf '%q ' "${run[@]}"; echo
        return 0
    fi
    trap ':' INT
    "${run[@]}" || status=$?
    trap - INT
    return "$status"
}

# Install or update agent NAME's npm package in $tools_dir/NAME. npm and the
# package's install scripts run in a jail that can write only the new copy.
install_agent() {
    agent_info "$1" || die "$1 is not an installable agent (see --list)"
    [[ $net != none ]] || die "installing needs the network; leave out --net none"
    local dest=$tools_dir/$1 new=$tools_dir/.$1.new npm version
    npm=$(resolve npm) || die "npm is not installed (needed to install $a_title)"

    cmd=() ro_paths=() state=() imports=() env=() path=() block_hosts=() hidden=()
    use_node npm
    ro_paths+=("$(pkg_root "$npm" || echo "$npm")")
    cmd=("$node" "$npm" install --global --prefix "$new" --no-fund --no-audit
         --loglevel=warn "$a_pkg")
    env=(npm_config_update_notifier=false)

    rm -rf -- "$new"
    mkdir -p -- "$new"
    git_before=
    profile=install build_jail "$new" off
    say "installing $a_pkg into $(tilde "$dest") (npm runs inside the jail)"
    if ! run_jail; then
        rm -rf -- "$new"
        die "installing $a_pkg failed"
    fi
    ((dry_run)) && { rm -rf -- "$new"; return 0; }
    if [[ ! -e $new/bin/$a_cmd ]]; then
        rm -rf -- "$new"
        die "$a_pkg installed no '$a_cmd' command"
    fi
    rm -rf -- "$dest"
    mv -- "$new" "$dest"
    # Read the version only from a plain file: the package could have left a
    # FIFO or a link to /dev/zero there.
    version=$dest/lib/node_modules/$a_pkg/package.json
    if [[ -f $version && ! -L $version ]]; then
        version=$(head -c 65536 -- "$version" | grep -om1 '"version": *"[^"]*"' |
                  cut -d'"' -f4) || version=''
    else
        version=''
    fi
    say "installed $a_title${version:+ $version}"
}

# --- the picker -------------------------------------------------------------

# Set the colour variables for output on file descriptor $1.
colours() {
    if [[ -t $1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
        bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' cyan=$'\e[36m'
        reset=$'\e[0m'
    else
        bold='' dim='' red='' green='' cyan='' reset=''
    fi
}

# Width of the terminal on stdin, or $1 when it doesn't say.
term_width() {
    local size
    size=$(stty size 2>/dev/null) || size=
    if [[ ${size#* } == [1-9]* ]]; then echo "${size#* }"; else echo "$1"; fi
}

# Set rows to one "key|name|status|where" entry per agent, then the shell.
agent_rows() {
    local line name p i=0
    rows=()
    for line in "${AGENTS[@]}"; do
        name=${line%%|*}
        agent_info "$name"
        i=$((i + 1))
        if [[ -e $tools_dir/$name/bin/$a_cmd ]]; then
            rows+=("$i|$a_title|installed|$(tilde "$tools_dir/$name")")
        elif p=$(command -v -- "$a_cmd" 2>/dev/null); then
            rows+=("$i|$a_title|installed|$(tilde "$p")")
        else
            rows+=("$i|$a_title|not installed|installs $a_pkg")
        fi
    done
    rows+=("s|Shell|built in|bash with the jail's view, no agent")
}

# Print rows[$1], highlighted when $2 is 1, cut to fit $cols columns.
print_row() {
    local key name status where mark=$green● pointer=' ' room
    IFS='|' read -r key name status where <<<"${rows[$1]}"
    [[ $status == "not installed" ]] && mark=$dim○
    room=$((cols - 39))
    if ((room < 8)); then
        where=''
    elif ((${#where} > room)); then
        where=…${where:${#where}-room+1}
    fi
    printf -v name '%-12s' "$name"
    printf -v status '%-13s' "$status"
    if (($2)); then
        pointer=$cyan❯$reset name=$bold$cyan$name$reset
    fi
    printf '%s  %s %s%s%s  %s  %s %s%s  %s%s%s\n' "$clear" "$pointer" "$dim" "$key" "$reset" \
        "$name" "$mark" "$status" "$reset" "$dim" "$where" "$reset"
}

# Print what the jail will allow, as the picker shows it.
describe_jail() {
    local n g
    case $net in
        isolated) n="public internet only; not localhost, the LAN or a tailnet"
                  ((${#host_ports[@]} == 0)) || n+="; host port ${host_ports[*]}" ;;
        none)     n="none" ;;
        host)     n="${bold}shared with the host (unsafe)${reset}" ;;
    esac
    case $git_mode in
        protect) g="hooks and config read-only" ;;
        ro)      g="read-only" ;;
        off)     g="not protected" ;;
    esac
    printf '%s  %sFolder%s   %s\n' "$clear" "$dim" "$reset" "$(tilde "$work")"
    printf '%s  %sNetwork%s  %s\n' "$clear" "$dim" "$reset" "$n"
    printf '%s  %sGit%s      %s\n' "$clear" "$dim" "$reset" "$g"
    printf '%s  %sSecrets%s  %s\n' "$clear" "$dim" "$reset" "$(describe_hidden)"
}

# The hidden files, relative to the working directory: the first three.
hidden_names() {
    local f out='' sep=''
    for f in "${hidden[@]:0:3}"; do out+=$sep${f#"$work"/} sep=', '; done
    ((${#hidden[@]} <= 3)) || out+=" and $((${#hidden[@]} - 3)) more"
    echo "$out"
}

# Say which files are hidden, as the picker shows it.
describe_hidden() {
    if ((!hide_default && ${#hide_patterns[@]} == 0)); then
        echo "nothing hidden (--no-hide)"
    elif ((${#hidden[@]} == 0)); then
        echo "no files to hide"
    else
        echo "hidden: $(hidden_names)"
    fi
}

# Draw the whole picker with row $1 highlighted; menu_lines is its height.
draw_menu() {
    local i
    printf '%s\n' "$clear"
    printf '%s  %sagent-jail%s  %srun an AI coding agent that can change only this folder%s\n' \
        "$clear" "$bold" "$reset" "$dim" "$reset"
    printf '%s\n' "$clear"
    for i in "${!rows[@]}"; do print_row "$i" "$((i == $1))"; done
    printf '%s\n' "$clear"
    describe_jail
    printf '%s\n' "$clear"
    printf '%s  %s↑/↓ choose · enter run · 1-%d or s pick · q quit%s\n' "$clear" "$dim" \
        "${#AGENTS[@]}" "$reset"
    menu_lines=$((${#rows[@]} + 10))
}

# Ask which agent to run, with the arrow keys (or by number on a terminal
# without cursor movement); sets profile.
pick_agent() {
    local sel=0 chosen=0 key rest c i
    colours 2
    agent_rows
    cols=$(term_width 80)
    if [[ ${TERM:-dumb} == dumb ]]; then
        clear=''
        draw_menu -1 >&2
        while ((!chosen)); do
            read -r -p "  Run which agent? " key || exit 1
            [[ $key == [qQ] ]] && exit 0
            for i in "${!rows[@]}"; do
                [[ ${rows[i]%%|*} == "${key,,}" ]] && sel=$i chosen=1
            done
        done
    else
        clear=$'\e[2K'
        menu_open=1
        # Hide the cursor, and clip long lines rather than wrap them, so the
        # menu is always menu_lines high and redraws in place.
        printf '\e[?25l\e[?7l' >&2
        draw_menu "$sel" >&2
        while ((!chosen)); do
            IFS= read -rsn1 key || exit 1
            case $key in
                '')   chosen=1 ;;
                q|Q)  exit 0 ;;
                k)    sel=$(((sel + ${#rows[@]} - 1) % ${#rows[@]})) ;;
                j)    sel=$(((sel + 1) % ${#rows[@]})) ;;
                $'\e')
                    # An escape sequence arrives at once; Esc on its own quits.
                    rest=''
                    while IFS= read -rsn1 -t 0.02 c; do rest+=$c; done
                    case $rest in
                        '')       exit 0 ;;
                        '[A'|OA)  sel=$(((sel + ${#rows[@]} - 1) % ${#rows[@]})) ;;
                        '[B'|OB)  sel=$(((sel + 1) % ${#rows[@]})) ;;
                    esac ;;
                *)    for i in "${!rows[@]}"; do
                          [[ ${rows[i]%%|*} == "${key,,}" ]] && sel=$i chosen=1
                      done ;;
            esac
            printf '\e[%dA\r' "$menu_lines" >&2
            draw_menu "$sel" >&2
        done
        # The key help has done its job: clear it and the blank line above it.
        printf '\e[A\e[2K\e[A\e[2K\e[?25h\e[?7h' >&2
        menu_open=0
    fi
    if ((sel == ${#AGENTS[@]})); then
        profile=shell
    else
        profile=${AGENTS[sel]%%|*}
    fi
}

# Offer to install agent $profile when it isn't installed; fail if declined.
offer_install() {
    local answer
    find_agent "$profile" >/dev/null && return 0
    agent_info "$profile"
    [[ -t 0 && -t 2 ]] || die "$a_title is not installed; install it with: $prog --install $profile"
    colours 2
    printf '\n  %s%s%s is not installed. agent-jail can install %s into\n' \
        "$bold" "$a_title" "$reset" "$a_pkg" >&2
    printf '  %s, with npm running inside a jail too.\n\n' "$(tilde "$tools_dir/$profile")" >&2
    read -r -p "  Install it now? [Y/n] " answer || exit 1
    [[ $answer == "" || $answer == [yY]* ]] || exit 1
    echo >&2
    install_agent "$profile"
}

# --- checking the setup -----------------------------------------------------

passed() { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
failed() { printf '  %s✗ %s%s\n' "$red" "$*" "$reset"; }
noted()  { printf '  %s○ %s%s\n' "$dim" "$*" "$reset"; }

# The command that installs the given tools (bwrap pasta nft node) here.
install_command() {
    local id='' pkgs=() t
    # shellcheck disable=SC1091
    [[ -r /etc/os-release ]] && id=$(. /etc/os-release; echo " $ID ${ID_LIKE:-} ")
    for t; do
        case $t in
            bwrap) pkgs+=(bubblewrap) ;;
            pasta) pkgs+=(passt) ;;
            nft)   pkgs+=(nftables) ;;
            node)  case $id in *" fedora "*|*" rhel "*) pkgs+=(npm) ;; *) pkgs+=(nodejs npm) ;; esac ;;
        esac
    done
    case $id in
        *" fedora "*|*" rhel "*)   echo "sudo dnf install ${pkgs[*]}" ;;
        *" debian "*|*" ubuntu "*) echo "sudo apt install ${pkgs[*]}" ;;
        *" arch "*)                echo "sudo pacman -S ${pkgs[*]}" ;;
        *)                         echo "install these packages: ${pkgs[*]}" ;;
    esac
}

# Check everything agent-jail needs, end by starting a real jail, and say how
# to get whatever is missing. Fails if a jail can't start.
check_setup() {
    local ok=1 can_jail=0 missing=() v npm_v dir out test_net=none
    local self
    self=$(readlink -f -- "${BASH_SOURCE[0]}")
    colours 1
    printf '\n  %sagent-jail%s %s\n\n' "$bold" "$reset" "$VERSION"

    if command -v bwrap >/dev/null; then
        v=$(bwrap --version 2>/dev/null) || v=
        v=${v##* }
        if [[ $(printf '%s\n' 0.8 "$v" | sort -V | head -n1) == 0.8 ]]; then
            passed "bubblewrap $v"
        else
            failed "bubblewrap ${v:-(unknown version)} is older than 0.8"
            ok=0
        fi
        if bwrap --unshare-user --ro-bind / / true 2>/dev/null; then
            passed "unprivileged user namespaces"
            can_jail=1
        else
            failed "bubblewrap can't create a user namespace"
            if [[ $(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null) == 1 ]]
            then
                printf '      AppArmor blocks them: sudo sysctl kernel.apparmor_restrict_unprivileged_userns=0\n'
            fi
            ok=0
        fi
    else
        failed "bubblewrap (bwrap) is missing"
        missing+=(bwrap)
        ok=0
    fi

    if find_tool pasta >/dev/null && find_tool nft >/dev/null; then
        passed "pasta and nft, for --net isolated (the default)"
        test_net=isolated
    else
        find_tool pasta >/dev/null || missing+=(pasta)
        find_tool nft >/dev/null || missing+=(nft)
        failed "pasta or nft is missing, so only --net none works"
        ok=0
    fi

    if command -v node >/dev/null && command -v npm >/dev/null; then
        v=$(node --version 2>/dev/null) || v=
        npm_v=$(npm --version 2>/dev/null) || npm_v=
        passed "node ${v#v} and npm $npm_v, for installing and running agents"
    else
        noted "node and npm are missing; agents installed by agent-jail need them"
        missing+=(node)
    fi

    if [[ $(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null || echo 1) != 0 ]]; then
        noted "TIOCSTI is on, so agents run in a new session (window resizes may not reach them)"
    fi

    if ((can_jail)); then
        dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/agent-jail-check.XXXXXX")
        if out=$(cd "$dir" && "$self" --net "$test_net" shell -c 'test ! -e ~/.ssh' \
                     </dev/null 2>&1); then
            passed "a test jail starts (--net $test_net)"
        else
            failed "a test jail didn't start:"
            printf '%s\n' "$out" | sed 's/^/      /'
            ok=0
        fi
        rm -rf -- "$dir"
    fi

    # Run from a checkout, the fix is ./install.sh; run from an installed copy,
    # it's putting that copy's directory on PATH.
    local on_path=1 fix
    fix="add $(tilde "${self%/*}") to your PATH"
    [[ -e ${self%/*}/../install.sh ]] && fix="run ./install.sh"
    if ! command -v agent-jail >/dev/null; then
        noted "agent-jail isn't on your PATH yet"
        on_path=0
    fi

    echo
    if ((${#missing[@]})); then
        printf '  To install what is missing:\n\n      %s\n\n' "$(install_command "${missing[@]}")"
    fi
    if ((ok && on_path)); then
        printf '  %sReady.%s Run %sagent-jail%s in a project folder.\n\n' "$green" "$reset" "$bold" "$reset"
    elif ((ok)); then
        printf '  %sThe jail works.%s To run agent-jail anywhere, %s.\n\n' "$green" "$reset" "$fix"
    fi
    ((ok))
}

# --- arguments --------------------------------------------------------------

net=isolated git_mode=protect force=0 dry_run=0 inspect=0 list=0 check=0 install=
host_ports=() extra_ro=() hide_default=1 hide_patterns=() show_patterns=()
while (($#)); do
    case $1 in
        --net)        net=${2:?--net needs a mode}; shift 2 ;;
        --net=*)      net=${1#*=}; shift ;;
        --host-port)  host_ports+=("${2:?--host-port needs a port}"); shift 2 ;;
        --host-port=*) host_ports+=("${1#*=}"); shift ;;
        --git)        git_mode=${2:?--git needs a mode}; shift 2 ;;
        --git=*)      git_mode=${1#*=}; shift ;;
        --ro)         extra_ro+=("${2:?--ro needs a path}"); shift 2 ;;
        --ro=*)       extra_ro+=("${1#*=}"); shift ;;
        --hide)       hide_patterns+=("${2:?--hide needs a pattern}"); shift 2 ;;
        --hide=*)     hide_patterns+=("${1#*=}"); shift ;;
        --show)       show_patterns+=("${2:?--show needs a pattern}"); shift 2 ;;
        --show=*)     show_patterns+=("${1#*=}"); shift ;;
        --no-hide)    hide_default=0 hide_patterns=(); shift ;;
        --install)    install=${2:?--install needs an agent}; shift 2 ;;
        --install=*)  install=${1#*=}; shift ;;
        --list)       list=1; shift ;;
        --check)      check=1; shift ;;
        --force)      force=1; shift ;;
        --shell)      inspect=1; shift ;;
        --dry-run)    dry_run=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        --version)    echo "$prog $VERSION"; exit 0 ;;
        --)           shift; break ;;
        -*)           die "unknown option: $1 (see --help)" ;;
        *)            break ;;
    esac
done

case $net in isolated|none|host) ;; *) die "--net must be isolated, none or host" ;; esac
case $git_mode in protect|ro|off) ;; *) die "--git must be protect, ro or off" ;; esac
for p in "${host_ports[@]}"; do
    if ! [[ $p =~ ^[0-9]+$ ]] || ((p < 1 || p > 65535)); then die "bad port: $p"; fi
done
((${#host_ports[@]} == 0)) || [[ $net == isolated ]] || die "--host-port needs --net isolated"
for p in "${hide_patterns[@]}" "${show_patterns[@]}"; do
    [[ -n $p && $p != */* ]] || die "bad pattern: '$p' (patterns match file names, without a /)"
done

state_base=${AGENT_JAIL_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/agent-jail}
tools_dir=$state_base/tools
work=$(pwd -P)

if ((check)); then
    check_setup
    exit
fi

if ((list)); then
    colours 1
    agent_rows
    if [[ -t 1 ]]; then cols=$(term_width 80); else cols=1000; fi
    clear=''
    printf '\n  %sagent-jail%s %s\n\n' "$bold" "$reset" "$VERSION"
    for i in "${!rows[@]}"; do print_row "$i" 0; done
    exit 0
fi

command -v bwrap >/dev/null || die "bubblewrap (bwrap) is not installed"
tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/agent-jail.XXXXXX")
menu_open=0
cleanup() {
    rm -rf -- "$tmp"
    # Restore the cursor and line wrap if the picker was left with q, Esc or Ctrl-C.
    if ((menu_open)); then printf '\e[?25h\e[?7h' >&2; fi
}
trap cleanup EXIT

tiocsti=$(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null || echo 1)
if [[ $tiocsti != 0 ]]; then
    tiocsti=1
    warn "TIOCSTI is enabled on this kernel; starting a new session (window resizes may not reach the agent)"
fi

if [[ -n $install ]]; then
    install_agent "$install"
    exit 0
fi

reason=$(refuse_reason "$work")
if [[ -n $reason ]]; then
    ((force)) || die "refusing to run in $work: $reason (use --force to override)"
    warn "running in $work although $reason"
fi
case $state_base/ in "$work"/*) die "the agent-jail state directory is inside $work" ;; esac
case $work/ in "$state_base"/*) die "refusing to run inside the agent-jail state directory" ;; esac

if (($#)); then
    profile=$1; shift
elif [[ -t 0 && -t 2 ]]; then
    find_secrets "$work"
    pick_agent
else
    usage >&2
    exit 2
fi
declare -F "profile_$profile" >/dev/null || die "unknown profile: $profile (see --help)"
[[ $profile == shell ]] || offer_install

for p in "${extra_ro[@]}"; do
    readlink -e -- "$p" >/dev/null || die "no such path for --ro: $p"
done

state_dir=$state_base/$profile
cmd=() ro_paths=() state=() imports=() env=() path=() block_hosts=()
mkdir -p -- "$state_dir"
"profile_$profile"
((inspect)) && cmd=(/usr/bin/bash)
cmd+=("$@")
for p in "${extra_ro[@]}"; do ro_paths+=("$(readlink -e -- "$p")"); done

git_before=$(find_git "$work")
find_secrets "$work"
((${#hidden[@]} == 0)) || say "hiding files that look like secrets (see --show): $(hidden_names)"
autorun_before=$(find_autorun "$work")
build_jail "$work" "$git_mode"
[[ $net == host ]] && warn "--net host: the agent can reach every localhost service and the X11 server"

status=0
run_jail || status=$?
((dry_run)) && exit 0

# Anything that git would execute on the host, created during the run.
new_git=$(LC_ALL=C comm -13 <(printf '%s\n' "$git_before") <(find_git "$work") |
          sed -e '/^$/d' -e 's/^[^ ]* //')
if [[ -n $new_git ]]; then
    warn "the agent created or replaced git metadata; its hooks and config run on the host when you use git there:"
    while IFS= read -r g; do printf '    %s\n' "$g" >&2; done <<<"$new_git"
    warn "inspect them first, e.g.: git -c core.hooksPath=/dev/null -c core.fsmonitor= status"
fi

# Agent, editor and direnv settings that can run commands, changed during the run.
changed=$(LC_ALL=C comm -13 <(printf '%s\n' "$autorun_before") <(find_autorun "$work") |
          sed -e '/^$/d' -e 's/^[0-9a-f]*  //')
if [[ -n $changed ]]; then
    warn "the agent changed files that agents, editors or direnv can run commands from:"
    while IFS= read -r f; do printf '    %s\n' "${f#"$work"/}" >&2; done <<<"$changed"
    warn "review them before you open this project with those tools outside the jail"
fi
exit "$status"
