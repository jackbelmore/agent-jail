#!/usr/bin/env bash
# agent-jail -- run an AI coding agent confined to the current directory.
#
# Filesystem: bubblewrap. The agent can write the current directory and its own
# private state, read /usr and a handful of /etc files, and see nothing else of
# $HOME. Network: pasta in a separate network namespace plus an nftables egress
# filter, so the agent reaches the public internet but not the host's localhost
# services, abstract sockets (X11), the LAN or a tailnet.
#
# What this does and does not protect: docs/THREAT_MODEL.md

# Profiles and helpers are called indirectly via "profile_$name".
# shellcheck disable=SC2317,SC2329
set -euo pipefail

readonly VERSION=0.2.0
readonly DNS_ADDR=169.254.1.1     # address pasta answers DNS on, inside the jail
readonly PROXY_PORT=3128          # the --allow-host forwarder, inside the jail
readonly PROXY_SOCKET=/tmp/.agent-jail-proxy   # the proxy's socket, inside the jail
# File names hidden in the project unless --no-hide, and the ones among them
# that stay visible: templates, not secrets. --hide and --show add to these.
readonly HIDE_DEFAULT=(.env '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' '*.jks' '*.keystore'
    id_rsa id_dsa id_ecdsa id_ecdsa_sk id_ed25519 id_ed25519_sk
    .netrc .git-credentials .pgpass '*.kdbx')
readonly SHOW_DEFAULT=('*.example' '*.sample' '*.template' '*.dist')
# Default --memory and --tasks: room for an agent and a big build, but not for
# a runaway process to take the whole machine.
readonly MEMORY_DEFAULT=50% TASKS_DEFAULT=4096

# System calls the seccomp filter refuses: name|x86_64 number|generic (aarch64)
# number|errno. Why each one, and how the filter is built: docs/SECCOMP.md.
# tests/test_seccomp.py checks the numbers against the kernel headers.
readonly SECCOMP_DENY=(
    # Other processes' memory, system calls and file descriptors
    "ptrace|101|117|EPERM" "process_vm_readv|310|270|EPERM"
    "process_vm_writev|311|271|EPERM" "kcmp|312|272|EPERM" "pidfd_getfd|438|438|EPERM"
    # The session keyring, shared with your login session
    "add_key|248|217|EPERM" "request_key|249|218|EPERM" "keyctl|250|219|EPERM"
    # Kernel attack surface no agent needs
    "bpf|321|280|EPERM" "perf_event_open|298|241|EPERM" "userfaultfd|323|282|EPERM"
    "io_uring_setup|425|425|ENOSYS" "io_uring_enter|426|426|ENOSYS"
    "io_uring_register|427|427|ENOSYS"
    # Calls that need capabilities the jail doesn't have, refused up front
    "mount|165|40|EPERM" "umount2|166|39|EPERM" "pivot_root|155|41|EPERM"
    "open_tree|428|428|EPERM" "move_mount|429|429|EPERM" "fsopen|430|430|EPERM"
    "fsconfig|431|431|EPERM" "fsmount|432|432|EPERM" "fspick|433|433|EPERM"
    "mount_setattr|442|442|EPERM" "init_module|175|105|EPERM"
    "finit_module|313|273|EPERM" "delete_module|176|106|EPERM"
    "kexec_load|246|104|EPERM" "kexec_file_load|320|294|EPERM" "reboot|169|142|EPERM"
    "swapon|167|224|EPERM" "swapoff|168|225|EPERM" "acct|163|89|EPERM"
    "syslog|103|116|EPERM" "quotactl|179|60|EPERM" "open_by_handle_at|304|265|EPERM"
)
prog=${0##*/}

# Agents agent-jail knows how to find and install, in the order the picker
# lists them: profile|name shown|npm package|command.
readonly AGENTS=(
    "claude|Claude Code|@anthropic-ai/claude-code|claude"
    "codex|Codex|@openai/codex|codex"
    "gemini|Gemini CLI|@google/gemini-cli|gemini"
    "qwen|Qwen Code|@qwen-code/qwen-code|qwen"
    "opencode|OpenCode|opencode-ai|opencode"
    "continue|Continue|@continuedev/cli|cn"
    "crush|Crush|@charmland/crush|crush"
    "copilot|Copilot CLI|@github/copilot|copilot"
)

die()  { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
warn() { printf '%s: warning: %s\n' "$prog" "$*" >&2; }
say()  { printf '%s: %s\n' "$prog" "$*" >&2; }

usage() {
    local names=() line hide
    for line in "${AGENTS[@]}"; do names+=("${line%%|*}"); done
    hide=$(fmt -w 78 <<<"Hidden in the project unless --no-hide: files named ${HIDE_DEFAULT[*]},
except ${SHOW_DEFAULT[*]}. A hidden file is still listed but can't be opened;
if git has it, git show can still print what was committed.")
    cat <<EOF
Usage: $prog [options] [PROFILE [ARGS...]]

Run PROFILE's agent so it can write only the current directory and its own
private state, read nothing else in \$HOME, and reach the public internet but
not localhost, the LAN or other sockets on this machine. Without PROFILE, pick
one from a list.

Profiles: ${names[*]} shell

Options:
  --net MODE        isolated  public internet only, via pasta (default)
                    none      no network at all
                    host      share the host network (UNSAFE: localhost
                              services and X11 become reachable)
  --allow-host NAME with --net isolated, reach only NAME over HTTPS, through a
                    proxy that refuses names resolving to private addresses:
                    example.com, *.example.com, example.com:8443 (repeatable)
  --host-port PORT  with --net isolated, forward 127.0.0.1:PORT inside the
                    jail to 127.0.0.1:PORT on the host, e.g. 11434 for a local
                    Ollama (repeatable)
  --git MODE        protect   .git/hooks and .git/config read-only (default)
                    ro        all of .git read-only (no commits inside)
                    off       no extra git protection
  --ro PATH         also expose PATH read-only (repeatable)
  --seccomp MODE    on   refuse TIOCSTI, ptrace, keyctl, io_uring and other
                         system calls agents don't need (default)
                    off  no seccomp filter (debuggers work)
  --memory SIZE     memory the jail may use: bytes with K, M, G or T, a
                    percentage of RAM, or off (default $MEMORY_DEFAULT)
  --tasks N         processes and threads the jail may run, or off
                    (default $TASKS_DEFAULT)
  --hide PATTERN    also hide project files whose name matches PATTERN, a
                    glob such as '*.secret' (repeatable)
  --show PATTERN    don't hide files whose name matches PATTERN (repeatable)
  --no-hide         hide nothing, not even the default list below
  --shell           start bash inside PROFILE's sandbox instead of the agent,
                    to see exactly what the agent would see
  --list            list the agents and whether they are installed
  --check           check that everything agent-jail needs is installed
  --install NAME    install or update NAME's npm package for the jail; npm
                    and the package's install scripts run inside a jail too
  --force           run in a directory that is normally refused
  --dry-run         print the sandbox command instead of running it
  --print-seccomp [ARCH]
                    write the seccomp filter (classic BPF) to stdout
  -h, --help        show this help
  --version         print the version

$hide

Options can also go in \${XDG_CONFIG_HOME:-~/.config}/agent-jail/config, one
per line as "name = value" (net = none, hide = *.secret, memory = 8G) or just
"name" (no-hide); the command line wins. A project's .agent-jail file uses the
same format but can only make the jail stricter.

Agent state lives in \${AGENT_JAIL_HOME:-\${XDG_DATA_HOME:-~/.local/share}/agent-jail}/PROFILE,
never in the agent's normal config directories. Agents installed with
--install live in its tools/ directory and are used before any on your PATH.
EOF
}

# --- helpers ----------------------------------------------------------------

# Resolve a command on the host PATH to its real file.
resolve() {
    local p
    p=$(command -v -- "$1" 2>/dev/null) || return 1
    readlink -f -- "$p"
}

# Find a system tool even when sbin directories are not on PATH (Debian/Ubuntu).
find_tool() {
    local d
    command -v -- "$1" 2>/dev/null && return 0
    for d in /usr/sbin /sbin /usr/bin; do
        [[ -x $d/$1 ]] && { echo "$d/$1"; return 0; }
    done
    return 1
}

# Walk up from a file inside an npm package to the package root, so the whole
# package (and its bundled native binaries) is exposed, read-only.
pkg_root() {
    local d=${1%/*} parent
    while [[ $d == /*/* ]]; do
        parent=${d%/*}
        if [[ ${parent##*/} == node_modules ]] ||
           [[ ${parent##*/} == @* && ${parent%/*} == */node_modules ]]; then
            printf '%s\n' "$d"
            return 0
        fi
        d=$parent
    done
    return 1
}

# Print why a working directory is refused, or nothing if it is fine.
refuse_reason() {
    local w=$1 d
    [[ $HOME/ == "$w"/* ]] && { echo "it contains your home directory"; return; }
    [[ $w == /*/* ]] || { echo "it is a top-level directory"; return; }
    mountpoint -q -- "$w" 2>/dev/null && { echo "it is the root of a mounted filesystem"; return; }
    for d in .ssh .gnupg .config .local .cache .pki .password-store .mozilla \
             .aws .kube .docker .var .claude .codex .gemini .copilot; do
        if [[ $w == "$HOME/$d" || $w == "$HOME/$d"/* ]]; then
            echo "it is inside ~/$d"
            return
        fi
    done
}

# Every .git entry (directory, or pointer file in a worktree/submodule) under
# the working directory, and every commondir file inside one, skipping
# dependency trees, as "device:inode path": a .git replaced by a new one at the
# same path is a different entry. A commondir file makes git take its config
# and hooks from the directory it names, so it counts as a pointer file. -mindepth 1
# keeps a working directory that is itself called venv or target from being
# pruned.
find_git() {
    find "$1" -mindepth 1 -maxdepth 6 \
        \( -name node_modules -o -name .venv -o -name venv -o -name target \) -prune \
        -o \( -name .git -o -name commondir -path '*/.git/*' \) -printf '%D:%i %p\n' \
        2>/dev/null | LC_ALL=C sort
}

# Checksums of the project files that agents, editors and direnv load code from
# (hooks, MCP servers, plugins, tasks) when you open the project on the host.
find_autorun() {
    local d=$1
    {
        find "$d" -maxdepth 1 -type f \( -name .mcp.json -o -name .envrc \
            -o -name opencode.json -o -name opencode.jsonc -o -name crush.json \
            -o -name .crush.json -o -name crushrc -o -name .crushrc \) -print0 || true
        find "$d"/.claude "$d"/.codex "$d"/.gemini "$d"/.qwen "$d"/.opencode \
            "$d"/.continue "$d"/.vscode "$d"/.cursor "$d"/.github "$d"/.claude-plugin \
            "$d"/.crush/commands "$d"/.crush/skills -maxdepth 4 -type f -print0 || true
        find "$d"/.crush -maxdepth 1 -name crush.json -type f -print0 || true
    } 2>/dev/null | xargs -0r sha256sum | LC_ALL=C sort
}

# Set hidden to the files under the working directory $1 that match a default
# hide pattern but no default exception, or a --hide pattern; and no --show
# pattern. .git and dependency trees are skipped. A matching
# symlink hides the file it leads to, if that is in the working directory;
# anything else it leads to isn't in the jail anyway.
find_secrets() {
    local d=$1 p f names=() keep=()
    local -A seen=()
    hidden=()
    if ((hide_default)); then
        for p in "${HIDE_DEFAULT[@]}"; do names+=(-o -name "$p"); done
        names=(\( "${names[@]:1}" \))
        for p in "${SHOW_DEFAULT[@]}"; do names+=(! -name "$p"); done
        names=(-o \( "${names[@]}" \))
    fi
    for p in "${hide_patterns[@]}"; do names+=(-o -name "$p"); done
    for p in "${show_patterns[@]}"; do keep+=(! -name "$p"); done
    ((${#names[@]})) || return 0
    while IFS= read -r -d '' f; do
        if [[ -L $f ]]; then
            f=$(readlink -f -- "$f") || continue
            [[ $f == "$d"/* && -f $f ]] || continue
        fi
        [[ -n ${seen[$f]:-} ]] && continue
        seen[$f]=1
        hidden+=("$f")
    done < <(find "$d" -mindepth 1 \
                 \( -name .git -o -name node_modules -o -name .venv -o -name venv \
                    -o -name target \) -prune \
                 -o \( -type f -o -type l \) \( "${names[@]:1}" \) "${keep[@]}" -print0 \
                 2>/dev/null)
}

# Shorten $HOME to ~ for display.
tilde() { printf '%s\n' "${1/#"$HOME"/\~}"; }

# --- agents -----------------------------------------------------------------

# Look up agent NAME in AGENTS; sets a_title, a_pkg and a_cmd.
agent_info() {
    local line name
    for line in "${AGENTS[@]}"; do
        IFS='|' read -r name a_title a_pkg a_cmd <<<"$line"
        [[ $name == "$1" ]] && return 0
    done
    return 1
}

# The real file of agent NAME's command: agent-jail's own install, then PATH.
find_agent() {
    agent_info "$1" || return 1
    local own=$tools_dir/$1/bin/$a_cmd real
    if [[ -e $own || -L $own ]]; then
        # The install was written from inside a jail; its command must not lead
        # anywhere else, or that place would be exposed to the agent.
        real=$(readlink -f -- "$own")
        if [[ $real != "$(readlink -f -- "$tools_dir/$1")"/* ]]; then
            warn "ignoring $(tilde "$own"): it points outside its install"
            return 1
        fi
        echo "$real"
    else
        resolve "$a_cmd"
    fi
}

# Expose the host's node read-only and set $node to it.
use_node() {
    node=$(resolve node) || die "node is not installed (needed for $1)"
    ro_paths+=("$node")
    # Agents start node themselves (MCP servers, hooks), so keep it on PATH.
    [[ ${node%/*} == /usr/bin ]] || path+=("${node%/*}")
}

# Set cmd and ro_paths to run agent NAME: its whole npm package read-only, plus
# node when the entry point is a node script rather than a native binary.
use_agent() {
    local bin first
    agent_info "$1"
    bin=$(find_agent "$1") || die "$a_title is not installed; install it with: $prog --install $1"
    ro_paths+=("$(pkg_root "$bin" || echo "$bin")")
    first=$(head -c128 -- "$bin" | tr -d '\0' | head -n1)
    if [[ $first == '#!'*node* || ( $first != '#!'* && $first != $'\x7fELF'* ) ]]; then
        use_node "$a_title"
        cmd=("$node" "$bin")
    else
        cmd=("$bin")
    fi
}

# Create a settings file in the profile's state the first time only; never
# write through a planted symlink.
seed() {
    local f=$state_dir/$1
    [[ -e $f || -L $f ]] && return 0
    mkdir -p -- "${f%/*}"
    (set -C; printf '%s\n' "$2" >"$f")
}

# --- profiles ---------------------------------------------------------------
# A profile sets:
#   cmd          the command to run (absolute paths)
#   ro_paths     host paths exposed read-only at the same path (program files)
#   state        paths relative to $HOME the agent may write; backed by
#                agent-jail's own state directory, never the real ones
#   imports      paths relative to $HOME bound read-only from the real $HOME on
#                top of state, so you keep one config but the agent can't edit it
#   env          extra NAME=VALUE pairs
#   path         extra directories put in front of PATH
#   block_hosts  hostnames that resolve to 0.0.0.0 inside the jail

profile_claude() {
    use_agent claude
    state=(.claude)
    # With CLAUDE_CONFIG_DIR set, .claude.json lives in ~/.claude too, so all
    # of Claude Code's state is in one private directory.
    env=(CLAUDE_CONFIG_DIR="$HOME/.claude" DISABLE_AUTOUPDATER=1)
}

profile_codex() {
    use_agent codex
    state=(.codex)
    # Codex sandboxes the commands it runs with its own bubblewrap, which needs
    # the user namespaces this jail disables, so every command would fail. The
    # jail is the sandbox: start with Codex's own turned off. Approval prompts
    # are a separate setting and stay as they are.
    seed .codex/config.toml 'sandbox_mode = "danger-full-access"
check_for_update_on_startup = false'
}

profile_gemini() {
    use_agent gemini
    state=(.gemini)
    # The package is read-only in the jail: update with --install instead.
    seed .gemini/settings.json '{
  "general": { "enableAutoUpdate": false, "enableAutoUpdateNotification": false },
  "privacy": { "usageStatisticsEnabled": false }
}'
}

profile_qwen() {
    use_agent qwen
    state=(.qwen)
    # Qwen Code's usage-statistics (RUM) endpoint.
    block_hosts=(gb4w8c3ygj-default-sea.rum.aliyuncs.com)
    seed .qwen/settings.json '{
  "general": { "enableAutoUpdate": false },
  "privacy": { "usageStatisticsEnabled": false }
}'
}

profile_opencode() {
    use_agent opencode
    state=(.config/opencode .local/share/opencode .cache/opencode .local/state/opencode)
    imports=(.config/opencode/opencode.json .config/opencode/opencode.jsonc)
    env=(OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_SHARE=1)
}

profile_continue() {
    use_agent continue
    state=(.continue)
    imports=(.continue/config.yaml)
}

profile_crush() {
    local root
    use_agent crush
    # The package's postinstall step downloads Crush's Go binary into bin/,
    # checking the sha256 in package.json; run it directly, not through node.
    root=$(pkg_root "$(find_agent crush)")
    [[ -x $root/bin/crush ]] && cmd=("$root/bin/crush")
    state=(.config/crush .local/share/crush .cache/crush)
    imports=(.config/crush/crush.json .config/crush/crushrc)
    env=(CRUSH_DISABLE_METRICS=1 DO_NOT_TRACK=1)
    # Crush's metrics endpoint (PostHog), should anything still try it.
    block_hosts=(data.charm.land)
}

profile_copilot() {
    use_agent copilot
    # The npm command starts a Node single-executable that unpacks the app into
    # ~/.cache/copilot on first run, so the cache is state too.
    state=(.copilot .cache/copilot)
    # Its updater downloads new versions into that cache and prefers them; the
    # package is read-only in the jail, so update with --install instead. Its
    # own bubblewrap sandbox needs the user namespaces the jail disables. With
    # no keyring (no D-Bus), the login token goes in the jail's ~/.copilot.
    env=(COPILOT_AUTO_UPDATE=false)
    seed .copilot/settings.json '{
  "autoUpdate": false,
  "storeTokenPlaintext": true,
  "sandbox": { "enabled": false }
}'
}

profile_shell() {
    cmd=(/usr/bin/bash)
}

# --- resource limits --------------------------------------------------------

# Set limit_props to the systemd-run properties for --memory and --tasks. They
# are left empty, with limits_off saying why, when both are off or there is no
# systemd user manager that can enforce them (no systemd, no user session, or
# cgroup controllers not delegated).
use_limits() {
    local probe=''
    limit_props=() limits_off=''
    if [[ $memory != off ]]; then
        # Without MemorySwapMax a runaway would page the machine to a halt
        # instead of being stopped at the limit.
        limit_props+=(-p "MemoryMax=$memory" -p MemorySwapMax=0)
        probe+=" && test -e \"\$d/memory.max\""
    fi
    if [[ $tasks != off ]]; then
        limit_props+=(-p "TasksMax=$tasks")
        probe+=" && test -e \"\$d/pids.max\""
    fi
    if ((${#limit_props[@]} == 0)); then
        limits_off="off"
    elif ! command -v systemd-run >/dev/null; then
        limits_off="none: systemd-run isn't installed"
    elif ! systemd-run --user --scope --quiet --collect "${limit_props[@]}" -- /bin/sh -c \
            "d=/sys/fs/cgroup\$(sed -n 's/^0:://p' /proc/self/cgroup)$probe" \
            </dev/null >/dev/null 2>&1; then
        limits_off="none: no systemd user session to enforce them"
    fi
    [[ -z $limits_off ]] || limit_props=()
}

# Say what the limits are, as the picker shows them.
describe_limits() {
    local m=$memory t="$tasks tasks"
    if [[ -n $limits_off ]]; then echo "$limits_off"; return; fi
    [[ $m == *% ]] && m+=" of RAM"
    [[ $m == off ]] && m="any amount of"
    [[ $t == "off tasks" ]] && t="any number of tasks"
    echo "$m memory, $t"
}

# --- seccomp ----------------------------------------------------------------

# Append one classic BPF instruction (code, jt, jf, k) to bpf, as the
# little-endian struct sock_filter the kernel reads.
bpf_op() {
    local x
    printf -v x '\\x%02x' $(($1 & 255)) $(($1 >> 8)) "$2" "$3" \
        $(($4 & 255)) $(($4 >> 8 & 255)) $(($4 >> 16 & 255)) $(($4 >> 24 & 255))
    bpf+=$x
}

# Write the seccomp filter for architecture $1 (x86_64 or aarch64) to stdout.
# The program, instruction by instruction, is in docs/SECCOMP.md.
seccomp_filter() {
    local arch col line name x86 generic errno nr ioctl
    local -r LD=0x20 JEQ=0x15 JGE=0x35 RET=0x06            # BPF_LD|W|ABS, BPF_JMP|K, BPF_RET|K
    local -r KILL=0x80000000 ALLOW=0x7fff0000 ERRNO=0x50000 # SECCOMP_RET_*
    case $1 in
        x86_64)  arch=0xc000003e col=x86 ioctl=16 ;;        # AUDIT_ARCH_X86_64
        aarch64) arch=0xc00000b7 col=generic ioctl=29 ;;    # AUDIT_ARCH_AARCH64
        *)       return 1 ;;
    esac
    bpf=''
    bpf_op $LD 0 0 4                    # the calling ABI
    bpf_op $JEQ 1 0 $arch
    bpf_op $RET 0 0 $KILL               # i386 or arm32 calls from a 64-bit process
    bpf_op $LD 0 0 0                    # the system call number
    if [[ $1 == x86_64 ]]; then
        bpf_op $JGE 0 1 0x40000000
        bpf_op $RET 0 0 $KILL           # the x32 ABI
    fi
    for line in "${SECCOMP_DENY[@]}"; do
        IFS='|' read -r name x86 generic errno <<<"$line"
        if [[ $col == x86 ]]; then nr=$x86; else nr=$generic; fi
        bpf_op $JEQ 0 1 "$nr"
        if [[ $errno == ENOSYS ]]; then
            bpf_op $RET 0 0 $((ERRNO | 38))
        else
            bpf_op $RET 0 0 $((ERRNO | 1))   # EPERM
        fi
    done
    bpf_op $JEQ 0 4 $ioctl
    bpf_op $LD 0 0 24                   # low 32 bits of the ioctl command
    bpf_op $JEQ 1 0 0x5412              # TIOCSTI
    bpf_op $JEQ 0 1 0x541c              # TIOCLINUX
    bpf_op $RET 0 0 $((ERRNO | 1))
    bpf_op $RET 0 0 $ALLOW
    printf '%b' "$bpf"
}

# --- the --allow-host proxy --------------------------------------------------
# Design: docs/ALLOW_HOST.md. Both programs use only Python's standard library.

# The proxy, on the host: CONNECT only, to names on the list whose addresses
# are all public. Arguments: socket path, log path, parent pid, then the list
# as name:port, where a name may start with "*.".
proxy_py() {
    cat <<'EOF'
import asyncio, ctypes, ipaddress, os, re, signal, socket, sys

RULES = []  # (name, port), from the arguments
NAME = re.compile(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*")
NAT64 = ipaddress.ip_network("64:ff9b::/96")


def listed(host, port):
    return any(p == port and (host == n or n.startswith("*.") and host.endswith(n[1:]))
               for n, p in RULES)


def public(addr):
    ip = ipaddress.ip_address(addr.split("%")[0])
    if ip.version == 6:  # IPv4 addresses inside IPv6 ones count as themselves
        if ip.ipv4_mapped:
            ip = ip.ipv4_mapped
        elif ip in NAT64:
            ip = ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF)
        elif ip.sixtofour:
            ip = ip.sixtofour
    return ip.is_global and not ip.is_multicast


async def refuse(writer, status, target, why):
    log.write(f"deny {target} {why}\n")
    writer.write(f"HTTP/1.1 {status}\r\nContent-Type: text/plain\r\n"
                 f"Connection: close\r\n\r\nagent-jail: {why}\n".encode())
    await writer.drain()


async def pipe(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
        if writer.can_write_eof():
            writer.write_eof()
    except OSError:
        pass


async def handle(reader, writer):
    target = "?"
    try:
        try:
            head = await asyncio.wait_for(reader.readuntil(b"\r\n\r\n"), 30)
            method, target, _ = head.split(b"\r\n", 1)[0].decode("latin-1").split(" ", 2)
        except (asyncio.IncompleteReadError, asyncio.LimitOverrunError, TimeoutError,
                ValueError):
            return await refuse(writer, "400 Bad Request", target, "not an HTTP request")
        if method != "CONNECT":
            return await refuse(writer, "405 Method Not Allowed", target,
                                "only HTTPS (CONNECT) goes through the proxy")
        host, _, port = target.rpartition(":")
        host = host.lower().rstrip(".")
        if not port.isdigit() or not 0 < int(port) < 65536:
            return await refuse(writer, "400 Bad Request", target, "no port")
        port = int(port)
        try:
            ipaddress.ip_address(host.strip("[]"))
            return await refuse(writer, "403 Forbidden", target,
                                "an IP address; only names on the --allow-host list")
        except ValueError:
            pass
        if len(host) > 253 or not NAME.fullmatch(host):
            return await refuse(writer, "400 Bad Request", target, "not a host name")
        if not listed(host, port):
            return await refuse(writer, "403 Forbidden", target, "not on the --allow-host list")
        try:
            infos = await asyncio.get_running_loop().getaddrinfo(
                host, port, type=socket.SOCK_STREAM)
        except OSError:
            return await refuse(writer, "502 Bad Gateway", target, "the name doesn't resolve")
        addrs = list(dict.fromkeys(info[4][0] for info in infos))
        private = [a for a in addrs if not public(a)]
        if private:
            return await refuse(writer, "403 Forbidden", target,
                                f"resolves to a non-public address, {private[0]}")
        for addr in addrs:  # the checked addresses, not the name again
            try:
                up_r, up_w = await asyncio.wait_for(asyncio.open_connection(addr, port), 10)
                break
            except (OSError, TimeoutError):
                continue
        else:
            return await refuse(writer, "502 Bad Gateway", target, "can't connect")
        log.write(f"allow {target} {addrs[0]}\n")
        writer.write(b"HTTP/1.1 200 Connection established\r\n\r\n")
        await writer.drain()
        await asyncio.gather(pipe(reader, up_w), pipe(up_r, writer))
        up_w.close()
    except Exception as e:  # one bad connection must not stop the proxy
        log.write(f"error {target} {e!r}\n")
    finally:
        writer.close()


async def main(sock):
    # Listen first, then rename into place: once the socket exists, it works.
    server = await asyncio.start_unix_server(handle, path=sock + ".new", limit=16384)
    os.chmod(sock + ".new", 0o600)
    os.rename(sock + ".new", sock)
    async with server:
        await server.serve_forever()


if __name__ == "__main__":
    sock, log_path, parent, *entries = sys.argv[1:]
    signal.signal(signal.SIGINT, signal.SIG_IGN)   # Ctrl-C is for the agent
    ctypes.CDLL(None).prctl(1, signal.SIGTERM)     # PR_SET_PDEATHSIG: end with agent-jail
    if os.getppid() != int(parent):
        sys.exit(0)
    RULES[:] = [(e.rsplit(":", 1)[0], int(e.rsplit(":", 1)[1])) for e in entries]
    log = open(log_path, "a", buffering=1)
    asyncio.run(main(sock))
EOF
}

# The forwarder, inside the jail: 127.0.0.1:PORT to the proxy's socket, for
# clients that only talk to proxies over TCP. It returns once it is listening.
# Arguments: socket path, port.
forwarder_py() {
    cat <<'EOF'
import os, signal, socket, sys, threading

path, port = sys.argv[1], int(sys.argv[2])
srv = socket.create_server(("127.0.0.1", port), backlog=1024)
if os.fork():
    os._exit(0)
os.setsid()                                    # out of the terminal's reach
signal.signal(signal.SIGINT, signal.SIG_IGN)
null = os.open(os.devnull, os.O_RDWR)
for fd in (0, 1, 2):
    os.dup2(null, fd)


def pump(src, dst):
    try:
        while data := src.recv(65536):
            dst.sendall(data)
    except OSError:
        pass
    try:
        dst.shutdown(socket.SHUT_WR)
    except OSError:
        pass


def serve(conn):
    with conn, socket.socket(socket.AF_UNIX) as up:
        try:
            up.connect(path)
        except OSError:
            return
        back = threading.Thread(target=pump, args=(up, conn))
        back.start()
        pump(conn, up)
        back.join()


while True:
    conn, _ = srv.accept()
    threading.Thread(target=serve, args=(conn,), daemon=True).start()
EOF
}

# Start the proxy for allow_hosts on $tmp/proxy.sock, and wait until it listens.
start_proxy() {
    local i
    python3 -I -c "$(proxy_py)" "$tmp/proxy.sock" "$tmp/proxy.log" "$$" "${allow_hosts[@]}" \
        </dev/null 2>"$tmp/proxy.err" &
    proxy_pid=$!
    for ((i = 0; i < 200; i++)); do
        [[ -S $tmp/proxy.sock ]] && return 0
        kill -0 "$proxy_pid" 2>/dev/null || break
        sleep 0.025
    done
    die "the --allow-host proxy didn't start: $(tail -n 3 -- "$tmp/proxy.err")"
}

# After the run, list what the proxy refused.
report_proxy() {
    local refused
    [[ -f $tmp/proxy.log ]] || return 0
    refused=$(awk '$1 == "deny" && !seen[$2]++ { $1 = ""; print "   " $0 }' "$tmp/proxy.log")
    [[ -n $refused ]] || return 0
    warn "the --allow-host proxy refused:"
    printf '%s\n' "$refused" >&2
}

# --- the sandbox ------------------------------------------------------------

# Set run to the command that starts cmd in a jail on directory $1, with git
# protection $2, from the profile variables above.
build_jail() {
    local dir=$1 git=$2 b p rel kv g f m h ports
    {
        printf '127.0.0.1 localhost agent-jail\n::1 localhost agent-jail\n'
        for h in "${block_hosts[@]}"; do printf '0.0.0.0 %s\n:: %s\n' "$h" "$h"; done
    } >"$tmp/hosts"

    b=(
        --ro-bind /usr /usr
        --symlink usr/lib /lib
        --symlink usr/lib64 /lib64
        --symlink usr/bin /bin
        --symlink usr/sbin /sbin
        --ro-bind "$tmp/hosts" /etc/hosts
    )
    for f in passwd group nsswitch.conf localtime ld.so.cache pki ssl ca-certificates \
             crypto-policies alternatives; do
        b+=(--ro-bind-try "/etc/$f" "/etc/$f")
    done
    case $net in
        isolated) printf 'nameserver %s\n' "$DNS_ADDR" >"$tmp/resolv.conf"
                  b+=(--ro-bind "$tmp/resolv.conf" /etc/resolv.conf) ;;
        host)     b+=(--ro-bind-try "$(readlink -f /etc/resolv.conf)" /etc/resolv.conf) ;;
        allowlist)
            # No resolver in the jail: names are resolved by the proxy, on the
            # host. Lookups fail at once rather than time out.
            printf 'nameserver 127.0.0.1\n' >"$tmp/resolv.conf"
            b+=(--ro-bind "$tmp/resolv.conf" /etc/resolv.conf) ;;
    esac
    b+=(
        --proc /proc
        --dev /dev
        --tmpfs /dev/shm
        --tmpfs /tmp
        --tmpfs "$HOME"
    )
    for p in "${ro_paths[@]}"; do
        [[ -e $p ]] || die "no such path: $p"
        b+=(--ro-bind "$p" "$p")
    done
    for rel in "${state[@]}"; do
        mkdir -p -- "$state_dir/$rel"
        b+=(--bind "$state_dir/$rel" "$HOME/$rel")
    done
    for rel in "${imports[@]}"; do
        # The import lands on a mount point inside agent-writable state; a symlink
        # planted there by an earlier run must not redirect it.
        [[ -L $state_dir/$rel ]] && rm -f -- "$state_dir/$rel"
        b+=(--ro-bind-try "$HOME/$rel" "$HOME/$rel")
    done
    b+=(--bind "$dir" "$dir")
    [[ $net == allowlist ]] && b+=(--bind "$tmp/proxy.sock" "$PROXY_SOCKET")

    # Git runs hooks and config-defined commands (core.fsmonitor, core.hooksPath,
    # filters, pagers) on the host the next time you type `git status` there. Make
    # the parts that can do that read-only for every repository in the directory.
    if [[ $git != off ]]; then
        # First pin each .git directory, and every directory between it and the
        # working directory, by binding it onto itself: a mount point can't be
        # renamed, so the agent can't move a repository aside and git init a
        # new one, with hooks of its choosing, in its place. Parents come first,
        # so that no pin covers a mount made inside it.
        local pins=() pin
        while IFS= read -r g; do
            g=${g#* }
            while [[ -n $g && $g != "$dir" ]]; do pins+=("$g"); g=${g%/*}; done
        done <<<"$git_before"
        if ((${#pins[@]})); then
            while IFS= read -r -d '' pin; do
                [[ -d $pin && ! -L $pin ]] && b+=(--bind "$pin" "$pin")
            done < <(printf '%s\0' "${pins[@]}" | LC_ALL=C sort -zu)
        fi
        while IFS= read -r g; do
            g=${g#* }
            [[ -n $g ]] || continue
            if [[ -L $g ]] || [[ -d $g && ( -L $g/hooks || -L $g/config ) ]]; then
                ((force)) || die "$g (or its hooks/config) is a symlink; inspect it or use --force"
            fi
            if [[ -f $g || $git == ro ]]; then
                # A pointer file (.git or commondir) must not be re-pointed at
                # an agent-made git dir.
                b+=(--ro-bind "$g" "$g")
                continue
            fi
            mkdir -p -- "$g/hooks"
            b+=(--ro-bind "$g/hooks" "$g/hooks")
            for f in config config.worktree; do
                [[ -e $g/$f ]] && b+=(--ro-bind "$g/$f" "$g/$f")
            done
            for m in "$g"/modules/*/ "$g"/worktrees/*/; do
                [[ -d $m ]] || continue
                for f in hooks config config.worktree; do
                    [[ -e $m$f ]] && b+=(--ro-bind "$m$f" "$m$f")
                done
            done
        done <<<"$git_before"
    fi

    # A secret file stays in place but becomes /dev/null on a nodev mount:
    # opening it fails, and it can't be removed, renamed or linked. This comes
    # after the pins above, which bind directories afresh from the host.
    for f in "${hidden[@]}"; do b+=(--ro-bind /dev/null "$f"); done

    b+=(
        --chdir "$dir"
        --unshare-all
        --unshare-user
        --disable-userns
        --uid "$(id -u)"
        --gid "$(id -g)"
        --hostname agent-jail
        --cap-drop ALL
        --die-with-parent
        --clearenv
        --setenv HOME "$HOME"
        --setenv USER "${USER:-$(id -un)}"
        --setenv LOGNAME "${USER:-$(id -un)}"
        --setenv PATH "$(IFS=:; echo "${path[*]}${path[*]:+:}/usr/bin:/bin")"
        --setenv TERM "${TERM:-xterm-256color}"
        --setenv COLORTERM "${COLORTERM:-truecolor}"
        --setenv LANG "${LANG:-C.UTF-8}"
        --setenv TMPDIR /tmp
        --setenv AGENT_JAIL "$profile"
    )
    if [[ $net == allowlist ]]; then
        for kv in HTTPS_PROXY https_proxy HTTP_PROXY http_proxy ALL_PROXY all_proxy; do
            b+=(--setenv "$kv" "http://127.0.0.1:$PROXY_PORT")
        done
        b+=(--setenv NO_PROXY "localhost,127.0.0.1,::1" --setenv no_proxy "localhost,127.0.0.1,::1"
            --setenv NODE_USE_ENV_PROXY 1)
    fi
    for kv in "${env[@]}"; do b+=(--setenv "${kv%%=*}" "${kv#*=}"); done
    [[ $net == isolated || $net == host ]] && b+=(--share-net)
    # TIOCSTI lets a process push keystrokes into its terminal, which the shell
    # would run after the jail exits. Kernels since 6.2 can turn it off, and the
    # seccomp filter refuses it; failing both, detach the agent from the
    # terminal instead.
    if [[ -n $seccomp_arch ]]; then
        b+=(--seccomp 3)
    elif ((tiocsti)); then
        b+=(--new-session)
    fi

    if [[ $net == allowlist ]]; then
        # shellcheck disable=SC2016  # $1/$@ are for the inner sh
        run=(bwrap "${b[@]}" -- /usr/bin/sh -c \
             'python3 -I -c "$1" "$2" "$3" && shift 3 && exec "$@"' agent-jail-forwarder \
             "$(forwarder_py)" "$PROXY_SOCKET" "$PROXY_PORT" "${cmd[@]}")
    else
        run=(bwrap "${b[@]}" -- "${cmd[@]}")
    fi
    if [[ -n $seccomp_arch ]]; then
        seccomp_filter "$seccomp_arch" >"$tmp/seccomp.bpf"
        # Opened just before bwrap starts, because pasta closes inherited files.
        # shellcheck disable=SC2016  # $1/$@ are for the inner sh
        run=(/usr/bin/sh -c 'f=$1 && shift && exec "$@" 3<"$f"' agent-jail-seccomp
             "$tmp/seccomp.bpf" "${run[@]}")
    fi

    if [[ $net == isolated ]]; then
        pasta=$(find_tool pasta) || die "--net isolated needs pasta (passt package); or choose --net none"
        nft=$(find_tool nft) || die "--net isolated needs nft (nftables) for the egress filter"
        ports=$(IFS=,; echo "${host_ports[*]}")
        # Applied inside the jail's own network namespace, before bwrap starts. Only
        # public addresses are reachable; loopback works for forwarded host ports.
        cat >"$tmp/egress.nft" <<EOF
table inet agent_jail {
    chain output {
        type filter hook output priority 0; policy accept;
        oif "lo" accept
        ip daddr $DNS_ADDR meta l4proto { tcp, udp } th dport 53 accept
        meta l4proto ipv6-icmp accept
        ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
                   169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16,
                   198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } reject
        ip6 daddr { ::/128, ::1/128, ::ffff:0:0/96, 64:ff9b::/96, fc00::/7,
                    fe80::/10, ff00::/8 } reject
    }
}
EOF
        # shellcheck disable=SC2016  # $1/$@ are for the inner sh
        run=("$pasta" --config-net --quiet --no-map-gw --dns-forward "$DNS_ADDR"
             -t none -u none -T "${ports:-none}" -U none --
             /usr/bin/sh -c '"$1" -f "$2" && shift 2 && exec "$@"' agent-jail-net
             "$nft" "$tmp/egress.nft" "${run[@]}")
    fi

    # The whole jail, pasta included, in a systemd scope with the limits.
    if ((${#limit_props[@]})); then
        run=(systemd-run --user --scope --quiet --collect
             --description "agent-jail $profile in $(tilde "$dir")" "${limit_props[@]}"
             -- "${run[@]}")
    fi
}

# Run $run, or print it with --dry-run. Ctrl-C belongs to the jailed process;
# this script just waits for it.
run_jail() {
    local status=0
    if ((dry_run)); then
        printf '%q ' "${run[@]}"; echo
        return 0
    fi
    [[ $net == allowlist ]] && start_proxy
    trap ':' INT
    "${run[@]}" || status=$?
    trap - INT
    return "$status"
}

# Install or update agent NAME's npm package in $tools_dir/NAME. npm and the
# package's install scripts run in a jail that can write only the new copy.
install_agent() {
    agent_info "$1" || die "$1 is not an installable agent (see --list)"
    [[ $net != none ]] || die "installing needs the network; leave out --net none"
    local dest=$tools_dir/$1 new=$tools_dir/.$1.new npm version
    npm=$(resolve npm) || die "npm is not installed (needed to install $a_title)"

    cmd=() ro_paths=() state=() imports=() env=() path=() block_hosts=() hidden=()
    use_node npm
    ro_paths+=("$(pkg_root "$npm" || echo "$npm")")
    cmd=("$node" "$npm" install --global --prefix "$new" --no-fund --no-audit
         --loglevel=warn "$a_pkg")
    env=(npm_config_update_notifier=false)

    rm -rf -- "$new"
    mkdir -p -- "$new"
    git_before=
    profile=install build_jail "$new" off
    say "installing $a_pkg into $(tilde "$dest") (npm runs inside the jail)"
    if ! run_jail; then
        rm -rf -- "$new"
        die "installing $a_pkg failed"
    fi
    ((dry_run)) && { rm -rf -- "$new"; return 0; }
    if [[ ! -e $new/bin/$a_cmd ]]; then
        rm -rf -- "$new"
        die "$a_pkg installed no '$a_cmd' command"
    fi
    rm -rf -- "$dest"
    mv -- "$new" "$dest"
    # Read the version only from a plain file: the package could have left a
    # FIFO or a link to /dev/zero there.
    version=$dest/lib/node_modules/$a_pkg/package.json
    if [[ -f $version && ! -L $version ]]; then
        version=$(head -c 65536 -- "$version" | grep -om1 '"version": *"[^"]*"' |
                  cut -d'"' -f4) || version=''
    else
        version=''
    fi
    say "installed $a_title${version:+ $version}"
}

# --- the picker -------------------------------------------------------------

# Set the colour variables for output on file descriptor $1.
colours() {
    if [[ -t $1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
        bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' cyan=$'\e[36m'
        reset=$'\e[0m'
    else
        bold='' dim='' red='' green='' cyan='' reset=''
    fi
}

# Width of the terminal on stdin, or $1 when it doesn't say.
term_width() {
    local size
    size=$(stty size 2>/dev/null) || size=
    if [[ ${size#* } == [1-9]* ]]; then echo "${size#* }"; else echo "$1"; fi
}

# Set rows to one "key|name|status|where" entry per agent, then the shell.
agent_rows() {
    local line name p i=0
    rows=()
    for line in "${AGENTS[@]}"; do
        name=${line%%|*}
        agent_info "$name"
        i=$((i + 1))
        if [[ -e $tools_dir/$name/bin/$a_cmd ]]; then
            rows+=("$i|$a_title|installed|$(tilde "$tools_dir/$name")")
        elif p=$(command -v -- "$a_cmd" 2>/dev/null); then
            rows+=("$i|$a_title|installed|$(tilde "$p")")
        else
            rows+=("$i|$a_title|not installed|installs $a_pkg")
        fi
    done
    rows+=("s|Shell|built in|bash with the jail's view, no agent")
}

# Print rows[$1], highlighted when $2 is 1, cut to fit $cols columns.
print_row() {
    local key name status where mark=$green● pointer=' ' room
    IFS='|' read -r key name status where <<<"${rows[$1]}"
    [[ $status == "not installed" ]] && mark=$dim○
    room=$((cols - 39))
    if ((room < 8)); then
        where=''
    elif ((${#where} > room)); then
        where=…${where:${#where}-room+1}
    fi
    printf -v name '%-12s' "$name"
    printf -v status '%-13s' "$status"
    if (($2)); then
        pointer=$cyan❯$reset name=$bold$cyan$name$reset
    fi
    printf '%s  %s %s%s%s  %s  %s %s%s  %s%s%s\n' "$clear" "$pointer" "$dim" "$key" "$reset" \
        "$name" "$mark" "$status" "$reset" "$dim" "$where" "$reset"
}

# Print what the jail will allow, as the picker shows it.
describe_jail() {
    local n g
    case $net in
        isolated) n="public internet only; not localhost, the LAN or a tailnet"
                  ((${#host_ports[@]} == 0)) || n+="; host port ${host_ports[*]}" ;;
        allowlist) n=$(printf ', %s' "${allow_hosts[@]}")
                   n="only ${n:2}, over HTTPS" ;;
        none)     n="none" ;;
        host)     n="${bold}shared with the host (unsafe)${reset}" ;;
    esac
    case $git_mode in
        protect) g="hooks and config read-only" ;;
        ro)      g="read-only" ;;
        off)     g="not protected" ;;
    esac
    printf '%s  %sFolder%s   %s\n' "$clear" "$dim" "$reset" "$(tilde "$work")"
    printf '%s  %sNetwork%s  %s\n' "$clear" "$dim" "$reset" "$n"
    printf '%s  %sGit%s      %s\n' "$clear" "$dim" "$reset" "$g"
    printf '%s  %sSecrets%s  %s\n' "$clear" "$dim" "$reset" "$(describe_hidden)"
    printf '%s  %sLimits%s   %s\n' "$clear" "$dim" "$reset" "$(describe_limits)"
}

# The hidden files, relative to the working directory: the first three.
hidden_names() {
    local f out='' sep=''
    for f in "${hidden[@]:0:3}"; do out+=$sep${f#"$work"/} sep=', '; done
    ((${#hidden[@]} <= 3)) || out+=" and $((${#hidden[@]} - 3)) more"
    echo "$out"
}

# Say which files are hidden, as the picker shows it.
describe_hidden() {
    if ((!hide_default && ${#hide_patterns[@]} == 0)); then
        echo "nothing hidden (--no-hide)"
    elif ((${#hidden[@]} == 0)); then
        echo "no files to hide"
    else
        echo "hidden: $(hidden_names)"
    fi
}

# Draw the whole picker with row $1 highlighted; menu_lines is its height.
draw_menu() {
    local i
    printf '%s\n' "$clear"
    printf '%s  %sagent-jail%s  %srun an AI coding agent that can change only this folder%s\n' \
        "$clear" "$bold" "$reset" "$dim" "$reset"
    printf '%s\n' "$clear"
    for i in "${!rows[@]}"; do print_row "$i" "$((i == $1))"; done
    printf '%s\n' "$clear"
    describe_jail
    printf '%s\n' "$clear"
    printf '%s  %s↑/↓ choose · enter run · 1-%d or s pick · q quit%s\n' "$clear" "$dim" \
        "${#AGENTS[@]}" "$reset"
    menu_lines=$((${#rows[@]} + 11))
}

# Ask which agent to run, with the arrow keys (or by number on a terminal
# without cursor movement); sets profile.
pick_agent() {
    local sel=0 chosen=0 key rest c i
    colours 2
    agent_rows
    cols=$(term_width 80)
    if [[ ${TERM:-dumb} == dumb ]]; then
        clear=''
        draw_menu -1 >&2
        while ((!chosen)); do
            read -r -p "  Run which agent? " key || exit 1
            [[ $key == [qQ] ]] && exit 0
            for i in "${!rows[@]}"; do
                [[ ${rows[i]%%|*} == "${key,,}" ]] && sel=$i chosen=1
            done
        done
    else
        clear=$'\e[2K'
        menu_open=1
        # Hide the cursor, and clip long lines rather than wrap them, so the
        # menu is always menu_lines high and redraws in place.
        printf '\e[?25l\e[?7l' >&2
        draw_menu "$sel" >&2
        while ((!chosen)); do
            IFS= read -rsn1 key || exit 1
            case $key in
                '')   chosen=1 ;;
                q|Q)  exit 0 ;;
                k)    sel=$(((sel + ${#rows[@]} - 1) % ${#rows[@]})) ;;
                j)    sel=$(((sel + 1) % ${#rows[@]})) ;;
                $'\e')
                    # An escape sequence arrives at once; Esc on its own quits.
                    rest=''
                    while IFS= read -rsn1 -t 0.02 c; do rest+=$c; done
                    case $rest in
                        '')       exit 0 ;;
                        '[A'|OA)  sel=$(((sel + ${#rows[@]} - 1) % ${#rows[@]})) ;;
                        '[B'|OB)  sel=$(((sel + 1) % ${#rows[@]})) ;;
                    esac ;;
                *)    for i in "${!rows[@]}"; do
                          [[ ${rows[i]%%|*} == "${key,,}" ]] && sel=$i chosen=1
                      done ;;
            esac
            printf '\e[%dA\r' "$menu_lines" >&2
            draw_menu "$sel" >&2
        done
        # The key help has done its job: clear it and the blank line above it.
        printf '\e[A\e[2K\e[A\e[2K\e[?25h\e[?7h' >&2
        menu_open=0
    fi
    if ((sel == ${#AGENTS[@]})); then
        profile=shell
    else
        profile=${AGENTS[sel]%%|*}
    fi
}

# Offer to install agent $profile when it isn't installed; fail if declined.
offer_install() {
    local answer
    find_agent "$profile" >/dev/null && return 0
    agent_info "$profile"
    [[ -t 0 && -t 2 ]] || die "$a_title is not installed; install it with: $prog --install $profile"
    colours 2
    printf '\n  %s%s%s is not installed. agent-jail can install %s into\n' \
        "$bold" "$a_title" "$reset" "$a_pkg" >&2
    printf '  %s, with npm running inside a jail too.\n\n' "$(tilde "$tools_dir/$profile")" >&2
    read -r -p "  Install it now? [Y/n] " answer || exit 1
    [[ $answer == "" || $answer == [yY]* ]] || exit 1
    echo >&2
    install_agent "$profile"
}

# --- checking the setup -----------------------------------------------------

passed() { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
failed() { printf '  %s✗ %s%s\n' "$red" "$*" "$reset"; }
noted()  { printf '  %s○ %s%s\n' "$dim" "$*" "$reset"; }

# The command that installs the given tools (bwrap pasta nft node) here.
install_command() {
    local id='' pkgs=() t
    # shellcheck disable=SC1091
    [[ -r /etc/os-release ]] && id=$(. /etc/os-release; echo " $ID ${ID_LIKE:-} ")
    for t; do
        case $t in
            bwrap) pkgs+=(bubblewrap) ;;
            pasta) pkgs+=(passt) ;;
            nft)   pkgs+=(nftables) ;;
            node)  case $id in *" fedora "*|*" rhel "*) pkgs+=(npm) ;; *) pkgs+=(nodejs npm) ;; esac ;;
        esac
    done
    case $id in
        *" fedora "*|*" rhel "*)   echo "sudo dnf install ${pkgs[*]}" ;;
        *" debian "*|*" ubuntu "*) echo "sudo apt install ${pkgs[*]}" ;;
        *" arch "*)                echo "sudo pacman -S ${pkgs[*]}" ;;
        *)                         echo "install these packages: ${pkgs[*]}" ;;
    esac
}

# Check everything agent-jail needs, end by starting a real jail, and say how
# to get whatever is missing. Fails if a jail can't start.
check_setup() {
    local ok=1 can_jail=0 missing=() v npm_v dir out test_net=none
    local self
    self=$(readlink -f -- "${BASH_SOURCE[0]}")
    colours 1
    printf '\n  %sagent-jail%s %s\n\n' "$bold" "$reset" "$VERSION"

    if command -v bwrap >/dev/null; then
        v=$(bwrap --version 2>/dev/null) || v=
        v=${v##* }
        if [[ $(printf '%s\n' 0.8 "$v" | sort -V | head -n1) == 0.8 ]]; then
            passed "bubblewrap $v"
        else
            failed "bubblewrap ${v:-(unknown version)} is older than 0.8"
            ok=0
        fi
        if bwrap --unshare-user --ro-bind / / true 2>/dev/null; then
            passed "unprivileged user namespaces"
            can_jail=1
        else
            failed "bubblewrap can't create a user namespace"
            if [[ $(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null) == 1 ]]
            then
                printf '      AppArmor blocks them: sudo sysctl kernel.apparmor_restrict_unprivileged_userns=0\n'
            fi
            ok=0
        fi
    else
        failed "bubblewrap (bwrap) is missing"
        missing+=(bwrap)
        ok=0
    fi

    if command -v python3 >/dev/null; then
        passed "python3, for --allow-host"
    else
        noted "python3 is missing, so --allow-host won't work"
    fi

    if find_tool pasta >/dev/null && find_tool nft >/dev/null; then
        passed "pasta and nft, for --net isolated (the default)"
        test_net=isolated
    else
        find_tool pasta >/dev/null || missing+=(pasta)
        find_tool nft >/dev/null || missing+=(nft)
        failed "pasta or nft is missing, so only --net none works"
        ok=0
    fi

    if command -v node >/dev/null && command -v npm >/dev/null; then
        v=$(node --version 2>/dev/null) || v=
        npm_v=$(npm --version 2>/dev/null) || npm_v=
        passed "node ${v#v} and npm $npm_v, for installing and running agents"
    else
        noted "node and npm are missing; agents installed by agent-jail need them"
        missing+=(node)
    fi

    use_limits
    if [[ -z $limits_off ]]; then
        passed "systemd user session, for memory and task limits"
    else
        noted "no systemd user session, so the jail runs without memory and task limits"
    fi

    if seccomp_filter "$(uname -m)" >/dev/null; then
        passed "a seccomp filter for $(uname -m)"
    else
        noted "no seccomp filter for $(uname -m), only x86_64 and aarch64"
        if [[ $(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null || echo 1) != 0 ]]; then
            noted "TIOCSTI is on, so agents run in a new session (window resizes may not reach them)"
        fi
    fi

    if ((can_jail)); then
        dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/agent-jail-check.XXXXXX")
        if out=$(cd "$dir" && "$self" --net "$test_net" shell -c 'test ! -e ~/.ssh' \
                     </dev/null 2>&1); then
            passed "a test jail starts (--net $test_net)"
        else
            failed "a test jail didn't start:"
            printf '%s\n' "$out" | sed 's/^/      /'
            ok=0
        fi
        rm -rf -- "$dir"
    fi

    # Run from a checkout, the fix is ./install.sh; run from an installed copy,
    # it's putting that copy's directory on PATH.
    local on_path=1 fix
    fix="add $(tilde "${self%/*}") to your PATH"
    [[ -e ${self%/*}/../install.sh ]] && fix="run ./install.sh"
    if ! command -v agent-jail >/dev/null; then
        noted "agent-jail isn't on your PATH yet"
        on_path=0
    fi

    echo
    if ((${#missing[@]})); then
        printf '  To install what is missing:\n\n      %s\n\n' "$(install_command "${missing[@]}")"
    fi
    if ((ok && on_path)); then
        printf '  %sReady.%s Run %sagent-jail%s in a project folder.\n\n' "$green" "$reset" "$bold" "$reset"
    elif ((ok)); then
        printf '  %sThe jail works.%s To run agent-jail anywhere, %s.\n\n' "$green" "$reset" "$fix"
    fi
    ((ok))
}

# --- configuration files ------------------------------------------------------

# The options a config file may set: "name=" takes a value, "name" is a switch.
readonly CONFIG_KEYS=" net= allow-host= host-port= git= ro= hide= show= no-hide seccomp= memory= tasks= "

# Set cfg_keys, cfg_values and cfg_where (file:line) to the settings in config
# file $1. Each line is "name = value", or just "name" for a switch; a line
# starting with # is a comment.
read_config() {
    local file=$1 line key value n=0 where
    cfg_keys=() cfg_values=() cfg_where=()
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        where="$(tilde "$file"):$n"
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [[ -z $line || $line == '#'* ]] && continue
        if [[ $line == *=* ]]; then
            key=${line%%=*} value=${line#*=}
            key=${key%"${key##*[![:space:]]}"}
            value=${value#"${value%%[![:space:]]*}"}
            [[ $CONFIG_KEYS == *" $key= "* ]] || die "$where: unknown setting: $key"
            [[ -n $value ]] || die "$where: $key needs a value"
        else
            key=$line value=''
            [[ $CONFIG_KEYS == *" $key "* ]] || die "$where: unknown setting, or no value: $key"
        fi
        cfg_keys+=("$key") cfg_values+=("$value") cfg_where+=("$where")
    done < <(head -c 65536 -- "$file")
}

# How strict each --net and --git mode is, from the loosest up.
net_rank() { case $1 in host) echo 0 ;; isolated) echo 1 ;; allowlist) echo 2 ;; none) echo 9 ;; esac; }
git_rank() { case $1 in off) echo 0 ;; protect) echo 1 ;; ro) echo 2 ;; esac; }

# A --memory or --tasks value as a number to compare; off is the most.
amount() {
    local v=$1 kib
    case $v in
        off) echo $((1 << 62)) ;;
        *%)  kib=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
             echo $((kib * 1024 * ${v%\%} / 100)) ;;
        *K)  echo $((${v%K} << 10)) ;;
        *M)  echo $((${v%M} << 20)) ;;
        *G)  echo $((${v%G} << 30)) ;;
        *T)  echo $((${v%T} << 40)) ;;
        *)   echo "$v" ;;
    esac
}

# Apply the project's .agent-jail on top of the user's settings. Anyone who can
# write the project can write this file, the agent included, so a setting in
# it only counts when it makes the jail stricter: a stricter --net or --git,
# more --hide patterns, lower --memory and --tasks. Anything else is ignored
# with a warning. A file that can't be read as settings stops the run.
apply_project_config() {
    local file=$work/.agent-jail i key value where applied=() ignored=() x hosts=() h
    local -A ours=()
    [[ -e $file || -L $file ]] || return 0
    [[ -f $file && ! -L $file ]] || die "$file must be a regular file, not a symlink"
    read_config "$file"
    for i in "${!cfg_keys[@]}"; do
        key=${cfg_keys[i]} value=${cfg_values[i]} where=${cfg_where[i]}
        case $key in
            allow-host)
                h=$(host_entry "$value") || die "$where: bad allow-host: $value"
                hosts+=("$h") ;;
            net)
                [[ $value != allowlist && -n $(net_rank "$value") ]] ||
                    die "$where: net must be isolated, none or host"
                if (($(net_rank "$value") > $(net_rank "$net"))); then
                    net=$value applied+=("net $value")
                elif [[ $value != "$net" ]]; then
                    ignored+=("net = $value")
                fi ;;
            git)
                [[ -n $(git_rank "$value") ]] || die "$where: git must be protect, ro or off"
                if (($(git_rank "$value") > $(git_rank "$git_mode"))); then
                    git_mode=$value applied+=("git $value")
                elif [[ $value != "$git_mode" ]]; then
                    ignored+=("git = $value")
                fi ;;
            seccomp)
                case $value in on|off) ;; *) die "$where: seccomp must be on or off" ;; esac
                if [[ $value == on && $seccomp == off ]]; then
                    seccomp=on applied+=("seccomp on")
                elif [[ $value != "$seccomp" ]]; then
                    ignored+=("seccomp = $value")
                fi ;;
            hide)
                [[ $value != */* ]] || die "$where: bad pattern: '$value' (no / allowed)"
                hide_patterns+=("$value") applied+=("hide $value") ;;
            memory)
                [[ $value =~ ^([1-9][0-9]*[KMGT]?|([1-9][0-9]?|100)%|off)$ ]] ||
                    die "$where: memory must be a size such as 8G or a percentage such as 50%"
                if (($(amount "$value") < $(amount "$memory"))); then
                    memory=$value applied+=("memory $value")
                elif [[ $value != "$memory" ]]; then
                    ignored+=("memory = $value")
                fi ;;
            tasks)
                [[ $value =~ ^([1-9][0-9]*|off)$ ]] || die "$where: tasks must be a number"
                if (($(amount "$value") < $(amount "$tasks"))); then
                    tasks=$value applied+=("tasks $value")
                elif [[ $value != "$tasks" ]]; then
                    ignored+=("tasks = $value")
                fi ;;
            *)  ignored+=("$key${value:+ = $value}") ;;
        esac
    done
    # A list of hosts narrows any network but none: to the project's list, or
    # to the hosts on both lists.
    if ((${#hosts[@]})) && [[ $net != none ]]; then
        if [[ $net == allowlist ]]; then
            for h in "${allow_hosts[@]}"; do ours[$h]=1; done
            allow_hosts=()
            for h in "${hosts[@]}"; do [[ -n ${ours[$h]:-} ]] && allow_hosts+=("$h"); done
            applied+=("only hosts on both lists")
        else
            net=allowlist allow_hosts=("${hosts[@]}") applied+=("allow-host ${hosts[*]}")
        fi
    fi
    [[ $net == allowlist ]] || allow_hosts=()
    # Host ports only exist with --net isolated.
    if [[ $net != isolated ]] && ((${#host_ports[@]})); then
        host_ports=() applied+=("no host ports")
    fi
    if ((${#applied[@]})); then
        x=$(printf ', %s' "${applied[@]}")
        say "the project's .agent-jail makes the jail stricter: ${x:2}"
    fi
    for x in "${ignored[@]}"; do
        warn "ignoring '$x' in .agent-jail: a project's file can only make the jail stricter"
    done
}

# Work out the --memory and --tasks limits; say so if they were asked for and
# can't be enforced.
setup_limits() {
    use_limits
    if ((limits_asked)) && [[ $limits_off == none:* ]]; then
        warn "running without --memory and --tasks limits (${limits_off#none: })"
    fi
}

# Set seccomp_arch to the architecture to build the seccomp filter for, or
# leave it empty with --seccomp off or where there is no filter for this one.
setup_seccomp() {
    seccomp_arch=''
    if [[ $seccomp == on ]]; then
        if seccomp_filter "$(uname -m)" >/dev/null; then
            seccomp_arch=$(uname -m)
        else
            warn "no seccomp filter for $(uname -m); running without one"
        fi
    fi
    if [[ -z $seccomp_arch ]] && ((tiocsti)); then
        warn "TIOCSTI is enabled on this kernel; starting a new session (window resizes may not reach the agent)"
    fi
}

# An --allow-host entry, lower-cased, as name:port (443 by default); fails if
# it isn't a host name or *.name, with an optional port.
host_entry() {
    local e=${1,,} name port=443
    name=${e%:*}
    [[ $e == *:* ]] && port=${e##*:}
    [[ $port =~ ^[1-9][0-9]{0,4}$ ]] && ((port < 65536)) || return 1
    [[ ${name#\*.} =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$ ]] ||
        return 1
    [[ ! ${name#\*.} =~ ^[0-9.]+$ ]] || return 1   # an IPv4 address
    echo "$name:$port"
}

# --- arguments --------------------------------------------------------------

# Settings from the user's config file go in front of the command line's, so
# the command line wins.
user_config=${XDG_CONFIG_HOME:-$HOME/.config}/agent-jail/config
if [[ -e $user_config ]]; then
    [[ -f $user_config ]] || die "$(tilde "$user_config") is not a regular file"
    read_config "$user_config"
    config_args=()
    for i in "${!cfg_keys[@]}"; do
        config_args+=("--${cfg_keys[i]}${cfg_values[i]:+=${cfg_values[i]}}")
    done
    set -- "${config_args[@]}" "$@"
fi

net=isolated git_mode=protect force=0 dry_run=0 inspect=0 list=0 check=0 install=
host_ports=() allow_hosts=() extra_ro=() hide_default=1 hide_patterns=() show_patterns=()
memory=$MEMORY_DEFAULT tasks=$TASKS_DEFAULT limits_asked=0 seccomp=on
while (($#)); do
    case $1 in
        --net)        net=${2:?--net needs a mode}; shift 2 ;;
        --net=*)      net=${1#*=}; shift ;;
        --allow-host) allow_hosts+=("${2:?--allow-host needs a name}"); shift 2 ;;
        --allow-host=*) allow_hosts+=("${1#*=}"); shift ;;
        --host-port)  host_ports+=("${2:?--host-port needs a port}"); shift 2 ;;
        --host-port=*) host_ports+=("${1#*=}"); shift ;;
        --git)        git_mode=${2:?--git needs a mode}; shift 2 ;;
        --git=*)      git_mode=${1#*=}; shift ;;
        --ro)         extra_ro+=("${2:?--ro needs a path}"); shift 2 ;;
        --ro=*)       extra_ro+=("${1#*=}"); shift ;;
        --hide)       hide_patterns+=("${2:?--hide needs a pattern}"); shift 2 ;;
        --hide=*)     hide_patterns+=("${1#*=}"); shift ;;
        --show)       show_patterns+=("${2:?--show needs a pattern}"); shift 2 ;;
        --show=*)     show_patterns+=("${1#*=}"); shift ;;
        --no-hide)    hide_default=0 hide_patterns=(); shift ;;
        --seccomp)    seccomp=${2:?--seccomp needs on or off}; shift 2 ;;
        --seccomp=*)  seccomp=${1#*=}; shift ;;
        --print-seccomp)
            seccomp_filter "${2:-$(uname -m)}" || die "no seccomp filter for ${2:-$(uname -m)}"
            exit 0 ;;
        --memory)     memory=${2:?--memory needs a size}; limits_asked=1; shift 2 ;;
        --memory=*)   memory=${1#*=}; limits_asked=1; shift ;;
        --tasks)      tasks=${2:?--tasks needs a number}; limits_asked=1; shift 2 ;;
        --tasks=*)    tasks=${1#*=}; limits_asked=1; shift ;;
        --install)    install=${2:?--install needs an agent}; shift 2 ;;
        --install=*)  install=${1#*=}; shift ;;
        --list)       list=1; shift ;;
        --check)      check=1; shift ;;
        --force)      force=1; shift ;;
        --shell)      inspect=1; shift ;;
        --dry-run)    dry_run=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        --version)    echo "$prog $VERSION"; exit 0 ;;
        --)           shift; break ;;
        -*)           die "unknown option: $1 (see --help)" ;;
        *)            break ;;
    esac
done

case $net in isolated|none|host) ;; *) die "--net must be isolated, none or host" ;; esac
case $git_mode in protect|ro|off) ;; *) die "--git must be protect, ro or off" ;; esac
case $seccomp in on|off) ;; *) die "--seccomp must be on or off" ;; esac
for p in "${host_ports[@]}"; do
    if ! [[ $p =~ ^[0-9]+$ ]] || ((p < 1 || p > 65535)); then die "bad port: $p"; fi
done
((${#host_ports[@]} == 0)) || [[ $net == isolated ]] || die "--host-port needs --net isolated"
if ((${#allow_hosts[@]})); then
    [[ $net == isolated ]] || die "--allow-host needs --net isolated"
    ((${#host_ports[@]} == 0)) || die "--allow-host and --host-port can't be used together"
    for i in "${!allow_hosts[@]}"; do
        allow_hosts[i]=$(host_entry "${allow_hosts[i]}") ||
            die "bad --allow-host: ${allow_hosts[i]} (a name such as example.com or *.example.com, with an optional :port)"
    done
    net=allowlist
fi
[[ $memory =~ ^([1-9][0-9]*[KMGT]?|([1-9][0-9]?|100)%|off)$ ]] ||
    die "--memory must be a size such as 8G, a percentage such as 50%, or off"
[[ $tasks =~ ^([1-9][0-9]*|off)$ ]] || die "--tasks must be a number or off"
for p in "${hide_patterns[@]}" "${show_patterns[@]}"; do
    [[ -n $p && $p != */* ]] || die "bad pattern: '$p' (patterns match file names, without a /)"
done

state_base=${AGENT_JAIL_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/agent-jail}
tools_dir=$state_base/tools
work=$(pwd -P)

if ((check)); then
    check_setup
    exit
fi

if ((list)); then
    colours 1
    agent_rows
    if [[ -t 1 ]]; then cols=$(term_width 80); else cols=1000; fi
    clear=''
    printf '\n  %sagent-jail%s %s\n\n' "$bold" "$reset" "$VERSION"
    for i in "${!rows[@]}"; do print_row "$i" 0; done
    exit 0
fi

command -v bwrap >/dev/null || die "bubblewrap (bwrap) is not installed"
tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/agent-jail.XXXXXX")
menu_open=0
cleanup() {
    [[ -n ${proxy_pid:-} ]] && kill "$proxy_pid" 2>/dev/null
    rm -rf -- "$tmp"
    # Restore the cursor and line wrap if the picker was left with q, Esc or Ctrl-C.
    if ((menu_open)); then printf '\e[?25h\e[?7h' >&2; fi
}
trap cleanup EXIT

tiocsti=$(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null || echo 1)
[[ $tiocsti == 0 ]] || tiocsti=1

if [[ -n $install ]]; then
    setup_limits
    setup_seccomp
    install_agent "$install"
    exit 0
fi

reason=$(refuse_reason "$work")
if [[ -n $reason ]]; then
    ((force)) || die "refusing to run in $work: $reason (use --force to override)"
    warn "running in $work although $reason"
fi
case $state_base/ in "$work"/*) die "the agent-jail state directory is inside $work" ;; esac
case $work/ in "$state_base"/*) die "refusing to run inside the agent-jail state directory" ;; esac
apply_project_config
setup_limits
setup_seccomp

if (($#)); then
    profile=$1; shift
elif [[ -t 0 && -t 2 ]]; then
    find_secrets "$work"
    pick_agent
else
    usage >&2
    exit 2
fi
declare -F "profile_$profile" >/dev/null || die "unknown profile: $profile (see --help)"
[[ $profile == shell ]] || offer_install

for p in "${extra_ro[@]}"; do
    readlink -e -- "$p" >/dev/null || die "no such path for --ro: $p"
done

state_dir=$state_base/$profile
cmd=() ro_paths=() state=() imports=() env=() path=() block_hosts=()
mkdir -p -- "$state_dir"
"profile_$profile"
((inspect)) && cmd=(/usr/bin/bash)
cmd+=("$@")
for p in "${extra_ro[@]}"; do ro_paths+=("$(readlink -e -- "$p")"); done

git_before=$(find_git "$work")
find_secrets "$work"
((${#hidden[@]} == 0)) || say "hiding files that look like secrets (see --show): $(hidden_names)"
autorun_before=$(find_autorun "$work")
build_jail "$work" "$git_mode"
[[ $net == host ]] && warn "--net host: the agent can reach every localhost service and the X11 server"

status=0
run_jail || status=$?
((dry_run)) && exit 0

report_proxy

# Anything that git would execute on the host, created during the run.
new_git=$(LC_ALL=C comm -13 <(printf '%s\n' "$git_before") <(find_git "$work") |
          sed -e '/^$/d' -e 's/^[^ ]* //')
if [[ -n $new_git ]]; then
    warn "the agent created or replaced git metadata; its hooks and config run on the host when you use git there:"
    while IFS= read -r g; do printf '    %s\n' "$g" >&2; done <<<"$new_git"
    warn "inspect them first, e.g.: git -c core.hooksPath=/dev/null -c core.fsmonitor= status"
fi

# Agent, editor and direnv settings that can run commands, changed during the run.
changed=$(LC_ALL=C comm -13 <(printf '%s\n' "$autorun_before") <(find_autorun "$work") |
          sed -e '/^$/d' -e 's/^[0-9a-f]*  //')
if [[ -n $changed ]]; then
    warn "the agent changed files that agents, editors or direnv can run commands from:"
    while IFS= read -r f; do printf '    %s\n' "${f#"$work"/}" >&2; done <<<"$changed"
    warn "review them before you open this project with those tools outside the jail"
fi
exit "$status"
